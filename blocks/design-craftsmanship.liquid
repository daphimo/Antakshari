{% liquid
  assign product_resource = closest.product | default: product
  assign print_placement = product_resource.metafields.custom.print_placement
  assign print_technique = product_resource.metafields.custom.print_technique_new
  assign blouse_collar = product_resource.metafields.custom.blouse_collar_new
  assign strap_type = product_resource.metafields.custom.strap_type_new
  assign pattern_placement = product_resource.metafields.custom.pattern_placement_new
  assign embellishments = product_resource.metafields.custom.embellishments_new
  assign embellishment_placement = product_resource.metafields.custom.embellishment_placement_new
  assign flare_details = product_resource.metafields.custom.flare_details
  assign drape_styles = product_resource.metafields.custom.drape_styles_new
  assign pallu_design = product_resource.metafields.custom.pallu_design
  assign border_type = product_resource.metafields.custom.border_type_new
  assign border_width = product_resource.metafields.custom.border_width
  assign color_primary = product_resource.metafields.custom.color_primary_new
  assign color_secondary = product_resource.metafields.custom.color_secondary_new
  assign zari_type = product_resource.metafields.custom.zari_type_new
  assign weave_technique = product_resource.metafields.custom.weave_technique_new
  assign waist_closure = product_resource.metafields.custom.waist_closure_new

  assign has_design_details = false
  if print_placement.value != blank or print_technique.value != blank or pattern_placement.value != blank or embellishments.value != blank or embellishment_placement.value != blank or flare_details.value != blank or drape_styles.value != blank or pallu_design.value != blank or border_type.value != blank or border_width.value != blank or color_primary.value != blank or color_secondary.value != blank or zari_type.value != blank or weave_technique.value != blank or waist_closure.value != blank
    assign has_design_details = true
  endif
%}

{% if has_design_details %}
  {{ 'metaobject-accordion.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'metaobject-accordion.js' | asset_url }}" defer="defer"></script>

  <metaobject-accordion class="metaobject-accordion" style="--pdb-margin-top: {{ block.settings.margin_top }}px; --pdb-margin-bottom: {{ block.settings.margin_bottom }}px; --pdb-margin-inline: {{ block.settings.margin_inline }}px; --pdb-padding-block: {{ block.settings.padding_vertical }}px; --pdb-padding-inline: {{ block.settings.padding_horizontal }}px; --pdb-background: {{ block.settings.background_color }}; --pdb-surface: {{ block.settings.surface_color }}; --pdb-text: {{ block.settings.text_color }}; --pdb-muted: {{ block.settings.muted_color }}; --pdb-accent: {{ block.settings.accent_color }}; --pdb-border: {{ block.settings.border_color }};" {{ block.shopify_attributes }}>
    <button
      class="metaobject-accordion__toggle"
      type="button"
      aria-expanded="{% if block.settings.open_by_default %}true{% else %}false{% endif %}"
      aria-controls="DesignCraftsmanshipContent-{{ block.id }}"
    >
      <span>{{ block.settings.heading | escape }}</span>
      <span class="metaobject-accordion__symbol" aria-hidden="true"></span>
    </button>

    <div
      id="DesignCraftsmanshipContent-{{ block.id }}"
      class="metaobject-accordion__content"
      aria-hidden="{% if block.settings.open_by_default %}false{% else %}true{% endif %}"
      style="height: {% if block.settings.open_by_default %}auto{% else %}0px{% endif %};"
    >
      <div class="metaobject-accordion__content-inner">
        <dl class="metaobject-accordion__details">
          {% if print_placement.value != blank %}
            <div>
              <dt>Body-Motif/Pattern</dt>
              <dd>
                {% if print_placement.value.size > 1 %}
                  <ul class="metaobject-accordion__value-list">
                    {% for placement in print_placement.value %}
                      {% if placement != blank %}<li>{{ placement | escape }}</li>{% endif %}
                    {% endfor %}
                  </ul>
                {% else %}
                  {{ print_placement.value.first | escape }}
                {% endif %}
              </dd>
            </div>
          {% endif %}
          {% if print_technique.value != blank %}<div><dt>Print Technique</dt><dd>{{ print_technique.value | escape }}</dd></div>{% endif %}
          {% if pattern_placement.value != blank %}<div><dt>Pallu-Motif/Pattern</dt><dd>{{ pattern_placement.value | escape }}</dd></div>{% endif %}
          {% if embellishments.value != blank %}
            <div>
              <dt>Embellishments</dt>
              <dd>
                {% if embellishments.value.size > 1 %}
                  <ul class="metaobject-accordion__value-list">
                    {% for embellishment in embellishments.value %}
                      {% if embellishment != blank %}<li>{{ embellishment | escape }}</li>{% endif %}
                    {% endfor %}
                  </ul>
                {% else %}
                  {{ embellishments.value.first | escape }}
                {% endif %}
              </dd>
            </div>
          {% endif %}
          {% if embellishment_placement.value != blank %}<div><dt>Embellishment Placement</dt><dd>{{ embellishment_placement.value | escape }}</dd></div>{% endif %}
          {% if flare_details.value != blank %}<div><dt>Flare Details</dt><dd>{{ flare_details.value | escape }}</dd></div>{% endif %}
          {% if drape_styles.value != blank %}
            <div>
              <dt>Drape Styles</dt>
              <dd>
                {% if drape_styles.value.size > 1 %}
                  <ul class="metaobject-accordion__value-list">
                    {% for drape_style in drape_styles.value %}
                      {% if drape_style != blank %}<li>{{ drape_style | escape }}</li>{% endif %}
                    {% endfor %}
                  </ul>
                {% else %}
                  {{ drape_styles.value.first | escape }}
                {% endif %}
              </dd>
            </div>
          {% endif %}
          {% if border_type.value != blank %}<div><dt>Border Type</dt><dd>{{ border_type.value | escape }}</dd></div>{% endif %}
          {% if border_width.value != blank %}<div><dt>Border Width</dt><dd>{{ border_width.value | escape }}</dd></div>{% endif %}
          {% if strap_type.value != blank %}<div><dt>Strap Type</dt><dd>{{ strap_type.value | escape }}</dd></div>{% endif %}
          {% if blouse_collar.value != blank %}<div><dt>Collar</dt><dd>{{ blouse_collar.value | escape }}</dd></div>{% endif %}
          {% if color_primary.value != blank %}<div><dt>Color Primary</dt><dd>{{ color_primary.value | escape }}</dd></div>{% endif %}
          {% if color_secondary.value != blank %}<div><dt>Color Secondary</dt><dd>{{ color_secondary.value | escape }}</dd></div>{% endif %}
          {% if zari_type.value != blank %}<div><dt>Zari Type</dt><dd>{{ zari_type.value | escape }}</dd></div>{% endif %}
          {% if weave_technique.value != blank %}
            <div>
              <dt>Weave / Technique</dt>
              <dd>
                {% if weave_technique.value.size > 1 %}
                  <ul class="metaobject-accordion__value-list">
                    {% for technique in weave_technique.value %}
                      {% if technique != blank %}<li>{{ technique | escape }}</li>{% endif %}
                    {% endfor %}
                  </ul>
                {% else %}
                  {{ weave_technique.value.first | escape }}
                {% endif %}
              </dd>
            </div>
          {% endif %}
          {% if waist_closure.value != blank %}<div><dt>Waist Closure</dt><dd>{{ waist_closure.value | escape }}</dd></div>{% endif %}
        </dl>
      </div>
    </div>
  </metaobject-accordion>
{% endif %}

{% schema %}
{
  "name": "Design & Craftsmanship",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Design & Craftsmanship"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "margin_inline", "label": "Side margins", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_vertical", "label": "Inner vertical spacing", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 4 },
    { "type": "range", "id": "padding_horizontal", "label": "Inner side spacing", "min": 8, "max": 36, "step": 2, "unit": "px", "default": 16 }
    ,{ "type": "header", "content": "Colors" },{ "type": "color", "id": "background_color", "label": "Background", "default": "#fffaf3" },{ "type": "color", "id": "surface_color", "label": "Detail surface", "default": "#f7efe4" },{ "type": "color", "id": "text_color", "label": "Heading and labels", "default": "#3d1f15" },{ "type": "color", "id": "muted_color", "label": "Detail text", "default": "#765f55" },{ "type": "color", "id": "accent_color", "label": "Accent and icon", "default": "#a84e2c" },{ "type": "color", "id": "border_color", "label": "Borders", "default": "#dfd0bf" }
  ],
  "presets": [
    {
      "name": "Design & Craftsmanship",
      "category": "Product"
    }
  ]
}
{% endschema %}
