{% liquid
  assign product_resource = closest.product | default: product
  assign product_form_id = 'BuyButtons-ProductForm-' | append: section.id
  assign checkbox_id = 'ConditionalPropertyToggle-' | append: product_resource.id | append: '-' | append: block.id
  assign input_id = 'ConditionalPropertyInput-' | append: product_resource.id | append: '-' | append: block.id
  assign field_id = 'ConditionalPropertyField-' | append: product_resource.id | append: '-' | append: block.id
  assign property_name = block.settings.property_name | strip
  if property_name == blank
    assign property_name = block.settings.checkbox_label | default: 'Custom detail'
  endif
%}

{{ 'conditional-line-item-property.css' | asset_url | stylesheet_tag }}
<script src="{{ 'conditional-line-item-property.js' | asset_url }}" defer="defer"></script>

<conditional-line-item-property
  class="conditional-property"
  style="padding-block-start: {{ block.settings.padding_top }}px; padding-block-end: {{ block.settings.padding_bottom }}px;"
  {{ block.shopify_attributes }}
>
  <label class="conditional-property__toggle-label" for="{{ checkbox_id }}">
    <input
      id="{{ checkbox_id }}"
      class="conditional-property__checkbox"
      type="checkbox"
      aria-controls="{{ field_id }}"
      aria-expanded="false"
      data-property-toggle
    >
    <span>{{ block.settings.checkbox_label | escape }}</span>
  </label>

  <div id="{{ field_id }}" class="conditional-property__field" data-property-field hidden>
    <label for="{{ input_id }}" class="visually-hidden">
      {{ block.settings.input_label | default: block.settings.checkbox_label | escape }}
    </label>
    <input
      id="{{ input_id }}"
      class="conditional-property__input"
      type="text"
      name="properties[{{ property_name | escape }}]"
      placeholder="{{ block.settings.placeholder | escape }}"
      maxlength="{{ block.settings.max_length }}"
      form="{{ product_form_id }}"
      data-property-input
      disabled
      {% if block.settings.required %}required aria-required="true"{% endif %}
    >
  </div>
</conditional-line-item-property>

{% schema %}
{
  "name": "Conditional property",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "checkbox_label",
      "label": "Checkbox label",
      "default": "Padded"
    },
    {
      "type": "text",
      "id": "property_name",
      "label": "Line item property name",
      "default": "Padded",
      "info": "This name appears in the cart and order details."
    },
    {
      "type": "text",
      "id": "input_label",
      "label": "Text field accessibility label",
      "default": "Padded details"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Text field placeholder",
      "default": "Enter details"
    },
    {
      "type": "range",
      "id": "max_length",
      "label": "Maximum characters",
      "min": 10,
      "max": 200,
      "step": 5,
      "default": 100
    },
    {
      "type": "checkbox",
      "id": "required",
      "label": "Require text when selected",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Conditional property",
      "category": "Product"
    }
  ]
}
{% endschema %}
