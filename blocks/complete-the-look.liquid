{% liquid
  assign product_resource = closest.product | default: product
  assign look_products = product_resource.metafields.custom.complete_the_look.value
  assign main_variant = product_resource.selected_or_first_available_variant
  assign has_unavailable_product = false

  unless main_variant.available
    assign has_unavailable_product = true
  endunless

  for look_product in look_products
    unless look_product.selected_or_first_available_variant.available
      assign has_unavailable_product = true
    endunless
  endfor
%}

{% if look_products != blank %}
  <script type="module" src="{{ 'complete-the-look.js' | asset_url }}"></script>

  <complete-the-look
    id="CompleteTheLook-{{ block.id }}"
    class="complete-the-look"
    data-main-variant-id="{{ main_variant.id }}"
    {{ block.shopify_attributes }}
  >
    {% if block.settings.heading != blank %}
      <h4 class="complete-the-look__heading">{{ block.settings.heading | escape }}</h4>
    {% endif %}

    <div class="complete-the-look__products" role="list">
      {% liquid
        assign card_product = product_resource
        assign card_variant = main_variant
        assign card_image = card_variant.featured_image | default: card_product.featured_image
      %}
      <a class="complete-the-look__product" href="{{ card_product.url }}" role="listitem">
        {% if card_image != blank %}
          {{
            card_image
            | image_url: width: 600
            | image_tag:
              class: 'complete-the-look__image',
              loading: 'lazy',
              widths: '160, 240, 360, 480, 600',
              sizes: '(min-width: 750px) 160px, 32vw',
              alt: card_image.alt
          }}
        {% endif %}
        <span class="complete-the-look__title">{{ card_product.title | escape }}</span>
        <span class="complete-the-look__price">{{ card_variant.price | money }}</span>
      </a>

      {% for look_product in look_products %}
        {% unless look_product.id == product_resource.id %}
          {% liquid
            assign look_variant = look_product.selected_or_first_available_variant
            assign look_image = look_variant.featured_image | default: look_product.featured_image
          %}
          <a
            class="complete-the-look__product"
            href="{{ look_product.url }}"
            data-look-variant-id="{{ look_variant.id }}"
            data-look-available="{{ look_variant.available }}"
            role="listitem"
          >
            {% if look_image != blank %}
              {{
                look_image
                | image_url: width: 600
                | image_tag:
                  class: 'complete-the-look__image',
                  loading: 'lazy',
                  widths: '160, 240, 360, 480, 600',
                  sizes: '(min-width: 750px) 160px, 32vw',
                  alt: look_image.alt
              }}
            {% endif %}
            <span class="complete-the-look__title">{{ look_product.title | escape }}</span>
            <span class="complete-the-look__price">{{ look_variant.price | money }}</span>
          </a>
        {% endunless %}
      {% endfor %}
    </div>

    <button
      class="button complete-the-look__button"
      type="button"
      data-complete-the-look-add
      {% if has_unavailable_product %}disabled{% endif %}
    >
      <span data-button-label>{{ block.settings.button_label | escape }}</span>
      <span class="complete-the-look__spinner" aria-hidden="true"></span>
    </button>

    <p
      class="complete-the-look__status{% unless has_unavailable_product %} visually-hidden{% endunless %}"
      role="status"
      data-status
      {% if has_unavailable_product %}data-error="true"{% endif %}
    >
      {% if has_unavailable_product %}One or more products in this look are unavailable.{% endif %}
    </p>
  </complete-the-look>
{% endif %}

{% stylesheet %}
  .complete-the-look {
    display: block;
    width: 100%;
  }

  .complete-the-look__heading {
    margin-block: 0 1rem;
  }

  .complete-the-look__products {
    display: flex;
    gap: 1rem;
    margin-block-end: 1rem;
    overflow-x: auto;
    padding-block-end: 0.25rem;
  }

  .complete-the-look__product {
    color: inherit;
    display: flex;
    flex: 0 0 min(36vw, 160px);
    flex-direction: column;
    text-decoration: none;
  }

  .complete-the-look__image {
    aspect-ratio: 1 / 1;
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }

  .complete-the-look__title {
    font-size: 0.9rem;
    line-height: 1.3;
    margin-block-start: 0.5rem;
  }

  .complete-the-look__price {
    font-size: 0.85rem;
    opacity: 0.75;
  }

  .complete-the-look__button {
    width: 100%;
  }

  .complete-the-look__spinner {
    animation: complete-the-look-spin 700ms linear infinite;
    border: 2px solid currentcolor;
    border-right-color: transparent;
    border-radius: 50%;
    display: none;
    height: 1rem;
    width: 1rem;
  }

  .complete-the-look__button[aria-busy='true'] .complete-the-look__spinner {
    display: inline-block;
  }

  .complete-the-look__status[data-error='true'] {
    color: var(--color-error, #b42318);
    margin-block: 0.75rem 0;
  }

  @keyframes complete-the-look-spin {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .complete-the-look__spinner { animation: none; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Complete the look",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complete the look"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add complete look to cart"
    }
  ],
  "presets": [
    {
      "name": "Complete the look",
      "category": "Product"
    }
  ]
}
{% endschema %}
