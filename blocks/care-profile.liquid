{% liquid
  assign product_resource = closest.product | default: product
  assign care = product_resource.metafields.custom.care_profile.value
%}

{% if care %}
  {{ 'metaobject-accordion.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'metaobject-accordion.js' | asset_url }}" defer="defer"></script>

  <metaobject-accordion class="metaobject-accordion" style="--pdb-margin-top: {{ block.settings.margin_top }}px; --pdb-margin-bottom: {{ block.settings.margin_bottom }}px; --pdb-margin-inline: {{ block.settings.margin_inline }}px; --pdb-padding-block: {{ block.settings.padding_vertical }}px; --pdb-padding-inline: {{ block.settings.padding_horizontal }}px; --pdb-background: {{ block.settings.background_color }}; --pdb-surface: {{ block.settings.surface_color }}; --pdb-text: {{ block.settings.text_color }}; --pdb-muted: {{ block.settings.muted_color }}; --pdb-accent: {{ block.settings.accent_color }}; --pdb-border: {{ block.settings.border_color }};" {{ block.shopify_attributes }}>
    <button
      class="metaobject-accordion__toggle"
      type="button"
      aria-expanded="{% if block.settings.open_by_default %}true{% else %}false{% endif %}"
      aria-controls="CareProfileContent-{{ block.id }}"
    >
      <span>{{ block.settings.heading | escape }}</span>
      <span class="metaobject-accordion__symbol" aria-hidden="true"></span>
    </button>

    <div
      id="CareProfileContent-{{ block.id }}"
      class="metaobject-accordion__content"
      aria-hidden="{% if block.settings.open_by_default %}false{% else %}true{% endif %}"
      style="height: {% if block.settings.open_by_default %}auto{% else %}0px{% endif %};"
    >
      <div class="metaobject-accordion__content-inner">
        {% if care.name != blank %}<h3 class="metaobject-accordion__name">{{ care.name }}</h3>{% endif %}

        {% if care.care_icon.value != blank %}
          <div class="metaobject-accordion__icons" aria-label="Care symbols">
            {% for care_icon in care.care_icon.value %}
              {{
                care_icon
                | image_url: width: 160
                | image_tag:
                  class: 'metaobject-accordion__icon',
                  loading: 'lazy',
                  widths: '40, 80, 120, 160',
                  sizes: '48px'
              }}
            {% endfor %}
          </div>
        {% endif %}

        <dl class="metaobject-accordion__details">
          {% if care.wash_method != blank %}<div><dt>Wash method</dt><dd>{{ care.wash_method }}</dd></div>{% endif %}
          {% if care.dry_clean_requirement != blank %}<div><dt>Dry-clean requirement</dt><dd>{{ care.dry_clean_requirement }}</dd></div>{% endif %}
          {% if care.water_temperature != blank %}<div><dt>Water temperature</dt><dd>{{ care.water_temperature }}</dd></div>{% endif %}
          {% if care.drying != blank %}<div><dt>Drying</dt><dd>{{ care.drying }}</dd></div>{% endif %}
          {% if care.iron_setting != blank %}<div><dt>Iron setting</dt><dd>{{ care.iron_setting }}</dd></div>{% endif %}
          {% if care.bleach_rule != blank %}<div><dt>Bleach rule</dt><dd>{{ care.bleach_rule }}</dd></div>{% endif %}
          {% if care.special_handling != blank %}<div><dt>Special handling</dt><dd>{{ care.special_handling }}</dd></div>{% endif %}
        </dl>
      </div>
    </div>
  </metaobject-accordion>
{% endif %}

{% schema %}
{
  "name": "Care Profile",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Care Profile"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "margin_inline", "label": "Side margins", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_vertical", "label": "Inner vertical spacing", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 4 },
    { "type": "range", "id": "padding_horizontal", "label": "Inner side spacing", "min": 8, "max": 36, "step": 2, "unit": "px", "default": 16 }
    ,{ "type": "header", "content": "Colors" },{ "type": "color", "id": "background_color", "label": "Background", "default": "#fffaf3" },{ "type": "color", "id": "surface_color", "label": "Detail surface", "default": "#f7efe4" },{ "type": "color", "id": "text_color", "label": "Heading and labels", "default": "#3d1f15" },{ "type": "color", "id": "muted_color", "label": "Detail text", "default": "#765f55" },{ "type": "color", "id": "accent_color", "label": "Accent and icon", "default": "#a84e2c" },{ "type": "color", "id": "border_color", "label": "Borders", "default": "#dfd0bf" }
  ],
  "presets": [
    {
      "name": "Care Profile",
      "category": "Product"
    }
  ]
}
{% endschema %}
