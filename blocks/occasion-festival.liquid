{% liquid
  assign product_resource = closest.product | default: product
  assign occasion = product_resource.metafields.custom[block.settings.metafield_key].value
%}

{% if occasion %}
  {{ 'metaobject-accordion.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'metaobject-accordion.js' | asset_url }}" defer="defer"></script>

  <metaobject-accordion class="metaobject-accordion" {{ block.shopify_attributes }}>
    <button
      class="metaobject-accordion__toggle"
      type="button"
      aria-expanded="{% if block.settings.open_by_default %}true{% else %}false{% endif %}"
      aria-controls="OccasionFestivalContent-{{ block.id }}"
    >
      <span>{{ block.settings.heading | escape }}</span>
      <span class="metaobject-accordion__symbol" aria-hidden="true"></span>
    </button>

    <div
      id="OccasionFestivalContent-{{ block.id }}"
      class="metaobject-accordion__content"
      aria-hidden="{% if block.settings.open_by_default %}false{% else %}true{% endif %}"
      style="height: {% if block.settings.open_by_default %}auto{% else %}0px{% endif %};"
    >
      <div class="metaobject-accordion__content-inner">
        {% if occasion.hero_image != blank %}
          {{
            occasion.hero_image.value
            | image_url: width: 1200
            | image_tag:
              class: 'metaobject-accordion__image',
              loading: 'lazy',
              widths: '320, 480, 720, 960, 1200',
              sizes: '(min-width: 750px) 40vw, 100vw'
          }}
        {% endif %}

        {% if occasion.name != blank %}<h3 class="metaobject-accordion__name">{{ occasion.name }}</h3>{% endif %}

        <dl class="metaobject-accordion__details">
          {% if occasion.parent_group != blank %}<div><dt>Parent group</dt><dd>{{ occasion.parent_group }}</dd></div>{% endif %}
          {% if occasion.festival_season != blank %}<div><dt>Festival season</dt><dd>{{ occasion.festival_season }}</dd></div>{% endif %}
          {% if occasion.guide_page != blank %}<div><dt>Guide page</dt><dd>{{ occasion.guide_page }}</dd></div>{% endif %}
          {% if occasion.active != blank %}<div><dt>Active</dt><dd>{{ occasion.active }}</dd></div>{% endif %}
          {% if occasion.sort_order != blank %}<div><dt>Sort order</dt><dd>{{ occasion.sort_order }}</dd></div>{% endif %}
        </dl>

        {% if occasion.short_description != blank %}
          <div class="metaobject-accordion__description rte">{{ occasion.short_description | metafield_tag }}</div>
        {% endif %}
      </div>
    </div>
  </metaobject-accordion>
{% endif %}

{% schema %}
{
  "name": "Occasion & Festival",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Occasion & Festival"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Product metafield key",
      "default": "occasions",
      "info": "The key after product.metafields.custom"
    }
  ],
  "presets": [
    {
      "name": "Occasion & Festival",
      "category": "Product"
    }
  ]
}
{% endschema %}
