{% liquid
  assign product_resource = closest.product | default: product
  assign occasion = product_resource.metafields.custom[block.settings.metafield_key].value
%}

{% if occasion %}
  {{ 'metaobject-accordion.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'metaobject-accordion.js' | asset_url }}" defer="defer"></script>

  <metaobject-accordion class="metaobject-accordion" style="--pdb-margin-top: {{ block.settings.margin_top }}px; --pdb-margin-bottom: {{ block.settings.margin_bottom }}px; --pdb-margin-inline: {{ block.settings.margin_inline }}px; --pdb-padding-block: {{ block.settings.padding_vertical }}px; --pdb-padding-inline: {{ block.settings.padding_horizontal }}px; --pdb-background: {{ block.settings.background_color }}; --pdb-surface: {{ block.settings.surface_color }}; --pdb-text: {{ block.settings.text_color }}; --pdb-muted: {{ block.settings.muted_color }}; --pdb-accent: {{ block.settings.accent_color }}; --pdb-border: {{ block.settings.border_color }};" {{ block.shopify_attributes }}>
    <button
      class="metaobject-accordion__toggle"
      type="button"
      aria-expanded="{% if block.settings.open_by_default %}true{% else %}false{% endif %}"
      aria-controls="OccasionFestivalContent-{{ block.id }}"
    >
      <span>{{ block.settings.heading | escape }}</span>
      <span class="metaobject-accordion__symbol" aria-hidden="true"></span>
    </button>

    <div
      id="OccasionFestivalContent-{{ block.id }}"
      class="metaobject-accordion__content"
      aria-hidden="{% if block.settings.open_by_default %}false{% else %}true{% endif %}"
      style="height: {% if block.settings.open_by_default %}auto{% else %}0px{% endif %};"
    >
      <div class="metaobject-accordion__content-inner">
        {% if occasion.hero_image != blank %}
          {{
            occasion.hero_image.value
            | image_url: width: 1200
            | image_tag:
              class: 'metaobject-accordion__image',
              loading: 'lazy',
              widths: '320, 480, 720, 960, 1200',
              sizes: '(min-width: 750px) 40vw, 100vw'
          }}
        {% endif %}

        {% if occasion.name != blank %}<h3 class="metaobject-accordion__name">{{ occasion.name }}</h3>{% endif %}

        <dl class="metaobject-accordion__details">
          {% if occasion.parent_group != blank %}<div><dt>Parent group</dt><dd>{{ occasion.parent_group }}</dd></div>{% endif %}
          {% if occasion.festival_season != blank %}<div><dt>Festival season</dt><dd>{{ occasion.festival_season }}</dd></div>{% endif %}
          {% if occasion.guide_page != blank %}<div><dt>Guide page</dt><dd>{{ occasion.guide_page }}</dd></div>{% endif %}
          {% if occasion.active != blank %}<div><dt>Active</dt><dd>{{ occasion.active }}</dd></div>{% endif %}
          {% if occasion.sort_order != blank %}<div><dt>Sort order</dt><dd>{{ occasion.sort_order }}</dd></div>{% endif %}
        </dl>

        {% if occasion.short_description != blank %}
          <div class="metaobject-accordion__description rte">{{ occasion.short_description | metafield_tag }}</div>
        {% endif %}
      </div>
    </div>
  </metaobject-accordion>
{% endif %}

{% schema %}
{
  "name": "Occasion & Festival",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Occasion & Festival"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Product metafield key",
      "default": "occasions",
      "info": "The key after product.metafields.custom"
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "margin_inline", "label": "Side margins", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_vertical", "label": "Inner vertical spacing", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 4 },
    { "type": "range", "id": "padding_horizontal", "label": "Inner side spacing", "min": 8, "max": 36, "step": 2, "unit": "px", "default": 16 }
    ,{ "type": "header", "content": "Colors" }
    ,{ "type": "color", "id": "background_color", "label": "Background", "default": "#fffaf3" },{ "type": "color", "id": "surface_color", "label": "Detail surface", "default": "#f7efe4" },{ "type": "color", "id": "text_color", "label": "Heading and labels", "default": "#3d1f15" },{ "type": "color", "id": "muted_color", "label": "Detail text", "default": "#765f55" },{ "type": "color", "id": "accent_color", "label": "Accent and icon", "default": "#a84e2c" },{ "type": "color", "id": "border_color", "label": "Borders", "default": "#dfd0bf" }
  ],
  "presets": [
    {
      "name": "Occasion & Festival",
      "category": "Product"
    }
  ]
}
{% endschema %}
