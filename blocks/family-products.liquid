{% liquid
  assign product_resource = closest.product | default: product
  assign family_products = product_resource.metafields.custom.family_matches.value
%}

{% if family_products != blank %}
  <div
    class="family-products"
    style="--family-products-columns-mobile: {{ block.settings.columns_mobile }}; --family-products-columns-desktop: {{ block.settings.columns_desktop }}; --fp-margin-top: {{ block.settings.margin_top }}px; --fp-margin-bottom: {{ block.settings.margin_bottom }}px; --fp-margin-inline: {{ block.settings.margin_inline }}px; --fp-padding: {{ block.settings.inner_spacing }}px; --fp-background: {{ block.settings.background_color }}; --fp-surface: {{ block.settings.surface_color }}; --fp-text: {{ block.settings.text_color }}; --fp-accent: {{ block.settings.accent_color }}; --fp-border: {{ block.settings.border_color }};"
    {{ block.shopify_attributes }}
  >
    {% if block.settings.heading != blank %}
      <h2 class="family-products__heading">{{ block.settings.heading | escape }}</h2>
    {% endif %}

    <div class="family-products__grid" role="list">
      {% for family_product in family_products %}
        {% if family_product != blank and family_product.featured_image != blank %}
          <a
            class="family-products__item{% if family_product.id == product_resource.id %} family-products__item--current{% endif %}"
            href="{{ family_product.url }}"
            aria-label="{{ family_product.title | escape }}"
            {% if family_product.id == product_resource.id %}aria-current="page"{% endif %}
            role="listitem"
          >
            {{
              family_product.featured_image
              | image_url: width: 1000
              | image_tag:
                class: 'family-products__image',
                loading: 'lazy',
                widths: '160, 240, 320, 480, 640, 800, 1000',
                sizes: '(min-width: 750px) 25vw, 50vw',
                alt: family_product.featured_image.alt
            }}
          </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .family-products {
    margin: var(--fp-margin-top) var(--fp-margin-inline) var(--fp-margin-bottom);
    padding: var(--fp-padding);
    color: var(--fp-text);
    background: var(--fp-background);
    border: 1px solid var(--fp-border);
    border-radius: 14px;
  }

  .family-products__heading {
    margin-block: 0 0.75rem;
    font-family: var(--font-heading--family);
    font-size: 1rem;
  }

  .family-products__grid {
    display: grid;
    grid-template-columns: repeat(var(--family-products-columns-mobile), minmax(0, 1fr));
    gap: 0.75rem;
  }

  .family-products__item {
    position: relative;
    display: block;
    overflow: hidden;
    background: var(--fp-surface);
    border: 1px solid var(--fp-border);
    border-radius: var(--style-border-radius-inputs, 10px);
    background: var(--color-background);
    box-shadow: 0 1px 2px rgb(var(--color-foreground-rgb) / 0.04);
    transition:
      border-color 180ms ease,
      box-shadow 180ms ease,
      transform 180ms ease;
  }

  .family-products__item:hover {
    border-color: rgb(var(--color-foreground-rgb) / 0.32);
    box-shadow: 0 7px 20px rgb(var(--color-foreground-rgb) / 0.11);
    transform: translateY(-2px);
  }

  .family-products__item--current,
  .family-products__item--current:hover {
    border-color: var(--fp-accent);
    box-shadow: 0 0 0 1px var(--color-background), 0 0 0 3px rgb(var(--color-foreground-rgb) / 0.18);
  }

  .family-products__item--current::after {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px rgb(var(--color-background-rgb, 255 255 255) / 0.45);
    content: '';
    pointer-events: none;
  }

  .family-products__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: top;
    transition: transform 350ms var(--ease-out-cubic, ease), filter 180ms ease;
  }

  .family-products__item:hover .family-products__image {
    transform: scale(1.035);
  }

  .family-products__item--current .family-products__image {
    filter: saturate(1.04) contrast(1.02);
  }

  .family-products__item:focus-visible {
    border-color: var(--color-foreground);
    outline: 2px solid var(--color-background);
    outline-offset: 2px;
    box-shadow: 0 0 0 4px var(--color-foreground);
  }

  @media screen and (min-width: 750px) {
    .family-products__grid {
      grid-template-columns: repeat(var(--family-products-columns-desktop), minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .family-products__item,
    .family-products__image {
      transition: none;
    }

    .family-products__item:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Family products",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Family products"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns on desktop",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "margin_inline", "label": "Side margins", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "inner_spacing", "label": "Inner spacing", "min": 6, "max": 30, "step": 2, "unit": "px", "default": 12 }
    ,{ "type": "header", "content": "Colors" },{ "type": "color", "id": "background_color", "label": "Background", "default": "#fffaf3" },{ "type": "color", "id": "surface_color", "label": "Product surface", "default": "#f7efe4" },{ "type": "color", "id": "text_color", "label": "Heading", "default": "#3d1f15" },{ "type": "color", "id": "accent_color", "label": "Selected border", "default": "#a84e2c" },{ "type": "color", "id": "border_color", "label": "Borders", "default": "#dfd0bf" }
  ],
  "presets": [
    {
      "name": "Family products",
      "category": "Product"
    }
  ]
}
{% endschema %}
