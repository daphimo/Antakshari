{% liquid
  assign product_resource = closest.product | default: product
  assign size_chart = product_resource.metafields.custom.size_chart.value
%}

{% if size_chart %}
  <size-chart-popup class="size-chart" style="--sc-margin-top: {{ block.settings.margin_top }}px; --sc-margin-bottom: {{ block.settings.margin_bottom }}px; --sc-margin-inline: {{ block.settings.margin_inline }}px; --sc-padding-y: {{ block.settings.padding_vertical }}px; --sc-padding-x: {{ block.settings.padding_horizontal }}px; --sc-background: {{ block.settings.background_color }}; --sc-text: {{ block.settings.text_color }}; --sc-accent: {{ block.settings.accent_color }}; --sc-border: {{ block.settings.border_color }};" {{ block.shopify_attributes }}>
    <button
      class="size-chart__trigger"
      type="button"
      aria-haspopup="dialog"
      aria-controls="SizeChartDialog-{{ block.id }}"
    >
      {{ block.settings.trigger_text }}
    </button>

    <div
      id="SizeChartDialog-{{ block.id }}"
      class="size-chart__overlay"
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
      aria-labelledby="SizeChartTitle-{{ block.id }}"
    >
      <div class="size-chart__panel" role="document">
        <div class="size-chart__header">
          <h2 id="SizeChartTitle-{{ block.id }}" class="size-chart__title">
            {% if size_chart.name != blank %}{{ size_chart.name }}{% else %}Size guide{% endif %}
          </h2>
          <button class="size-chart__close" type="button" aria-label="Close size guide">
            <span class="svg-wrapper" aria-hidden="true">
              {{- 'icon-close.svg' | inline_asset_content -}}
            </span>
          </button>
        </div>

        <div class="size-chart__body">
          {% if size_chart.chart != blank %}
            {{
              size_chart.chart.value
              | image_url: width: 1600
              | image_tag:
                class: 'size-chart__image',
                loading: 'lazy',
                widths: '320, 480, 720, 960, 1200, 1600',
                sizes: '(min-width: 900px) 800px, 100vw'
            }}
          {% endif %}

          <dl class="size-chart__details">
            {% if size_chart.product_group != blank %}
              <div><dt>Product group</dt><dd>{{ size_chart.product_group }}</dd></div>
            {% endif %}
            {% if size_chart.target_age_gender != blank %}
              <div><dt>Target age / gender</dt><dd>{{ size_chart.target_age_gender }}</dd></div>
            {% endif %}
            {% if size_chart.unit != blank %}
              <div><dt>Unit</dt><dd>{{ size_chart.unit }}</dd></div>
            {% endif %}
          </dl>

          {% if size_chart.standard_fit_note.value != blank %}
            <div class="size-chart__notes">
              <h3>Standard fit notes</h3>
              <ul>
                {% for fit_note in size_chart.standard_fit_note.value %}
                  {% if fit_note != blank %}<li>{{ fit_note }}</li>{% endif %}
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          {% if size_chart.measurement_guide != blank %}
            <div class="size-chart__guide">
              <h3>Measurement guide</h3>
              <div>{{ size_chart.measurement_guide | escape | newline_to_br }}</div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </size-chart-popup>

  <script>
    if (!customElements.get('size-chart-popup')) {
      customElements.define(
        'size-chart-popup',
        class extends HTMLElement {
          connectedCallback() {
            this.trigger = this.querySelector('.size-chart__trigger');
            this.overlay = this.querySelector('.size-chart__overlay');
            this.closeButton = this.querySelector('.size-chart__close');
            if (!this.trigger || !this.overlay || !this.closeButton) return;

            this.handleKeydown = (event) => {
              if (event.key === 'Escape' && this.isOpen) this.close();
            };
            this.trigger.addEventListener('click', () => this.open());
            this.closeButton.addEventListener('click', () => this.close());
            this.overlay.addEventListener('click', (event) => {
              if (event.target === this.overlay) this.close();
            });
          }

          disconnectedCallback() {
            document.removeEventListener('keydown', this.handleKeydown);
            if (this.isOpen) this.unlockPage();
          }

          get isOpen() {
            return this.overlay?.classList.contains('is-open');
          }

          open() {
            this.previousOverflow = document.documentElement.style.overflow;
            this.previousBodyOverflow = document.body.style.overflow;
            document.documentElement.style.overflow = 'hidden';
            document.body.style.overflow = 'hidden';
            this.overlay.setAttribute('aria-hidden', 'false');
            this.overlay.classList.add('is-open');
            document.addEventListener('keydown', this.handleKeydown);
            this.closeButton.focus({ preventScroll: true });
          }

          close() {
            this.overlay.classList.remove('is-open');
            this.overlay.setAttribute('aria-hidden', 'true');
            document.removeEventListener('keydown', this.handleKeydown);
            this.unlockPage();
            this.trigger.focus({ preventScroll: true });
          }

          unlockPage() {
            document.documentElement.style.overflow = this.previousOverflow || '';
            document.body.style.overflow = this.previousBodyOverflow || '';
          }
        }
      );
    }
  </script>
{% endif %}

{% stylesheet %}
  .size-chart {
    display: block;
    margin: var(--sc-margin-top) var(--sc-margin-inline) var(--sc-margin-bottom);
  }

  .size-chart__trigger {
    appearance: none;
    width: auto;
    min-height: 28px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    color: var(--sc-accent);
    border: 0;
    border-radius: 0;
    background: transparent;
    font: inherit;
    font-size: 0.82rem;
    font-weight: 650;
    line-height: 1.35;
    text-align: left;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
    cursor: pointer;
  }

  .size-chart__trigger:hover {
    text-decoration-thickness: 2px;
  }

  .size-chart__trigger:focus-visible {
    outline: 2px solid var(--sc-accent);
    outline-offset: 4px;
  }

  .size-chart__overlay {
    position: fixed;
    inset: 0;
    z-index: var(--layer-dialog, 1000);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: rgb(0 0 0 / 0.5);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 300ms ease, visibility 300ms ease;
  }

  .size-chart__overlay.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .size-chart__panel {
    width: min(100%, 560px);
    max-height: min(70dvh, 620px);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--sc-border);
    border-radius: 14px;
    background: var(--sc-background);
    color: var(--sc-text);
    box-shadow: 0 18px 55px rgb(0 0 0 / 0.22);
    opacity: 0;
    transform: translateY(12px) scale(0.98);
    transition: opacity 220ms ease, transform 220ms ease;
  }

  .size-chart__overlay.is-open .size-chart__panel {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .size-chart__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 14px;
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.15);
  }

  .size-chart__title {
    margin: 0;
    font-size: 1.05rem;
    line-height: 1.3;
  }

  .size-chart__close {
    appearance: none;
    flex: 0 0 32px;
    width: 32px;
    height: 32px;
    padding: 8px;
    border: 0;
    border-radius: 50%;
    background: rgb(var(--color-foreground-rgb) / 0.06);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }

  .size-chart__close svg {
    width: 100%;
    height: 100%;
  }

  .size-chart__body {
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 14px;
  }

  .size-chart__image {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin-block-end: 14px;
    border-radius: 0;
  }

  .size-chart__details {
    margin: 0;
  }

  .size-chart__details > div {
    display: grid;
    grid-template-columns: minmax(140px, 0.4fr) 1fr;
    gap: 12px;
    padding-block: 8px;
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .size-chart__details dt,
  .size-chart__notes h3,
  .size-chart__guide h3 {
    font-weight: 600;
  }

  .size-chart__details dd {
    margin: 0;
  }

  .size-chart__notes,
  .size-chart__guide {
    margin-block-start: 14px;
  }

  .size-chart__notes h3,
  .size-chart__guide h3 {
    margin: 0 0 8px;
  }

  .size-chart__notes ul {
    margin-block: 0;
    padding-inline-start: 20px;
  }

  @media (max-width: 600px) {
    .size-chart__overlay {
      padding: 12px;
    }

    .size-chart__panel {
      max-height: 72dvh;
    }

    .size-chart__details > div {
      grid-template-columns: minmax(105px, 0.4fr) 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .size-chart__overlay,
    .size-chart__panel {
      transition-duration: 0.01ms;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Size Chart",
  "tag": null,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "trigger_text",
      "label": "Trigger text",
      "default": "Size guide"
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 10 },
    { "type": "range", "id": "margin_inline", "label": "Side margins", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_vertical", "label": "Vertical padding", "min": 8, "max": 24, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "padding_horizontal", "label": "Side padding", "min": 10, "max": 36, "step": 2, "unit": "px", "default": 16 }
    ,{ "type": "header", "content": "Colors" },{ "type": "color", "id": "background_color", "label": "Background and dialog", "default": "#fffaf3" },{ "type": "color", "id": "text_color", "label": "Text", "default": "#3d1f15" },{ "type": "color", "id": "accent_color", "label": "Accent", "default": "#a84e2c" },{ "type": "color", "id": "border_color", "label": "Borders", "default": "#dfd0bf" }
  ],
  "presets": [
    {
      "name": "Size Chart",
      "category": "Product"
    }
  ]
}
{% endschema %}
