{% liquid
  assign product_resource = closest.product | default: product
  assign claim = product_resource.metafields.custom.claims_and_certifications.value
  assign gi_tag_status = product_resource.metafields.custom.gi_tag_status
%}

{% if claim or gi_tag_status.value != blank %}
  <claims-certifications-accordion class="claims-certifications" style="--cc-margin-top: {{ block.settings.margin_top }}px; --cc-margin-bottom: {{ block.settings.margin_bottom }}px; --cc-margin-inline: {{ block.settings.margin_inline }}px; --cc-padding-y: {{ block.settings.padding_vertical }}px; --cc-padding-x: {{ block.settings.padding_horizontal }}px; --cc-background: {{ block.settings.background_color }}; --cc-surface: {{ block.settings.surface_color }}; --cc-text: {{ block.settings.text_color }}; --cc-muted: {{ block.settings.muted_color }}; --cc-accent: {{ block.settings.accent_color }}; --cc-accent-text: {{ block.settings.accent_text_color }}; --cc-border: {{ block.settings.border_color }};" {{ block.shopify_attributes }}>
    <button
      class="claims-certifications__toggle"
      type="button"
      aria-expanded="{% if block.settings.open_by_default %}true{% else %}false{% endif %}"
      aria-controls="ClaimsCertificationsContent-{{ block.id }}"
    >
      <span>{{ block.settings.heading | escape }}</span>
      <span class="claims-certifications__symbol" aria-hidden="true"></span>
    </button>

    <div
      id="ClaimsCertificationsContent-{{ block.id }}"
      class="claims-certifications__content"
      aria-hidden="{% if block.settings.open_by_default %}false{% else %}true{% endif %}"
      style="height: {% if block.settings.open_by_default %}auto{% else %}0px{% endif %};"
    >
      <div class="claims-certifications__content-inner">
        {% if claim.icon.value != blank %}
          <div class="claims-certifications__icons" aria-label="Certification icons">
            {% for claim_icon in claim.icon.value %}
              {{
                claim_icon
                | image_url: width: 200
                | image_tag:
                  class: 'claims-certifications__icon',
                  loading: 'lazy',
                  widths: '48, 96, 144, 200',
                  sizes: '64px'
              }}
            {% endfor %}
          </div>
        {% endif %}

        {% if claim.name != blank %}
          <h3 class="claims-certifications__name">{{ claim.name }}</h3>
        {% endif %}

        <dl class="claims-certifications__details">
          {% if gi_tag_status.value != blank %}
            <div><dt>GI Tag Status</dt><dd>{{ gi_tag_status.value | escape | newline_to_br }}</dd></div>
          {% endif %}
          {% if claim.type != blank %}
            <div><dt>Type</dt><dd>{{ claim.type }}</dd></div>
          {% endif %}
          {% if claim.verification_note != blank %}
            <div><dt>Verification note</dt><dd>{{ claim.verification_note }}</dd></div>
          {% endif %}
        </dl>

        {% if claim.short_description != blank %}
          <div class="claims-certifications__description rte">
            {{ claim.short_description | metafield_tag }}
          </div>
        {% endif %}

        {% if claim.certificate.value != blank %}
          <a
            class="claims-certifications__download"
            href="{{ claim.certificate.value.url }}"
            download
          >
            {{ block.settings.download_label | escape }}
          </a>
        {% endif %}
      </div>
    </div>
  </claims-certifications-accordion>

  <script>
    if (!customElements.get('claims-certifications-accordion')) {
      customElements.define(
        'claims-certifications-accordion',
        class extends HTMLElement {
          connectedCallback() {
            this.button = this.querySelector('.claims-certifications__toggle');
            this.content = this.querySelector('.claims-certifications__content');
            if (!this.button || !this.content) return;

            this.button.addEventListener('click', () => this.toggle());
            this.content.addEventListener('transitionend', (event) => {
              if (event.propertyName === 'height' && this.button.getAttribute('aria-expanded') === 'true') {
                this.content.style.height = 'auto';
              }
            });
          }

          toggle() {
            const isOpen = this.button.getAttribute('aria-expanded') === 'true';
            this.button.setAttribute('aria-expanded', String(!isOpen));
            this.content.setAttribute('aria-hidden', String(isOpen));

            if (isOpen) {
              this.content.style.height = `${this.content.scrollHeight}px`;
              requestAnimationFrame(() => {
                this.content.style.height = '0px';
              });
            } else {
              this.content.style.height = `${this.content.scrollHeight}px`;
            }
          }
        }
      );
    }
  </script>
{% endif %}

{% stylesheet %}
  .claims-certifications {
    display: block;
    margin: var(--cc-margin-top) var(--cc-margin-inline) var(--cc-margin-bottom);
    padding: var(--cc-padding-y) var(--cc-padding-x);
    overflow: hidden;
    color: var(--cc-text);
    background: var(--cc-background);
    border: 0;
    border-block-start: 1px solid var(--cc-border);
    border-radius: 0;
  }

  .claims-certifications__toggle {
    appearance: none;
    width: 100%;
    padding: 12px 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font: inherit;
    font-weight: 600;
    font-size: 0.875rem;
    letter-spacing: 0.025em;
    text-align: left;
    cursor: pointer;
  }

  .claims-certifications__symbol {
    position: relative;
    flex: 0 0 16px;
    width: 16px;
    height: 16px;
  }

  .claims-certifications__symbol::before,
  .claims-certifications__symbol::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 16px;
    height: 1px;
    background: currentColor;
    transform: translateY(-50%);
  }

  .claims-certifications__symbol::after {
    transform: translateY(-50%) rotate(90deg);
    transition: transform 200ms ease;
  }

  .claims-certifications__toggle[aria-expanded='true'] .claims-certifications__symbol::after {
    transform: translateY(-50%) rotate(0deg);
  }

  .claims-certifications__content {
    overflow: hidden;
    transition: height 300ms ease;
  }

  .claims-certifications__content-inner {
    padding-block: 0 20px;
  }

  .claims-certifications__icons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-block-end: 16px;
  }

  .claims-certifications__icon {
    display: block;
    width: 64px;
    height: 64px;
    object-fit: contain;
    padding: 8px;
    background: var(--cc-surface);
    border: 1px solid var(--cc-border);
    border-radius: 12px;
  }

  .claims-certifications__name {
    margin: 0 0 12px;
  }

  .claims-certifications__details {
    margin: 0;
  }

  .claims-certifications__details > div {
    display: grid;
    grid-template-columns: minmax(140px, 0.4fr) 1fr;
    gap: 12px;
    padding-block: 8px;
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .claims-certifications__details dt {
    font-weight: 600;
  }

  .claims-certifications__details dd {
    margin: 0;
    color: var(--cc-muted);
  }

  .claims-certifications__description,
  .claims-certifications__download {
    margin-block-start: 16px;
  }

  .claims-certifications__download {
    display: inline-flex;
    padding: 9px 14px;
    color: var(--cc-accent-text);
    background: var(--cc-accent);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 650;
    text-decoration: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .claims-certifications__content,
    .claims-certifications__symbol::after {
      transition-duration: 0.01ms;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Claims & Certifications",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Claims & Certifications"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "text",
      "id": "download_label",
      "label": "Certificate link label",
      "default": "Download certificate"
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "margin_inline", "label": "Side margins", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_vertical", "label": "Inner vertical spacing", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 4 },
    { "type": "range", "id": "padding_horizontal", "label": "Inner side spacing", "min": 8, "max": 36, "step": 2, "unit": "px", "default": 16 }
    ,{ "type": "header", "content": "Colors" },{ "type": "color", "id": "background_color", "label": "Background", "default": "#fffaf3" },{ "type": "color", "id": "surface_color", "label": "Icon surface", "default": "#f7efe4" },{ "type": "color", "id": "text_color", "label": "Heading and labels", "default": "#3d1f15" },{ "type": "color", "id": "muted_color", "label": "Detail text", "default": "#765f55" },{ "type": "color", "id": "accent_color", "label": "Button background", "default": "#a84e2c" },{ "type": "color", "id": "accent_text_color", "label": "Button text", "default": "#ffffff" },{ "type": "color", "id": "border_color", "label": "Borders", "default": "#dfd0bf" }
  ],
  "presets": [
    {
      "name": "Claims & Certifications",
      "category": "Product"
    }
  ]
}
{% endschema %}
