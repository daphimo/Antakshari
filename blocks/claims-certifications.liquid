{% liquid
  assign product_resource = closest.product | default: product
  assign claim = product_resource.metafields.custom.claims_and_certifications.value
%}

{% if claim %}
  <claims-certifications-accordion class="claims-certifications" {{ block.shopify_attributes }}>
    <button
      class="claims-certifications__toggle"
      type="button"
      aria-expanded="{% if block.settings.open_by_default %}true{% else %}false{% endif %}"
      aria-controls="ClaimsCertificationsContent-{{ block.id }}"
    >
      <span>{{ block.settings.heading | escape }}</span>
      <span class="claims-certifications__symbol" aria-hidden="true"></span>
    </button>

    <div
      id="ClaimsCertificationsContent-{{ block.id }}"
      class="claims-certifications__content"
      aria-hidden="{% if block.settings.open_by_default %}false{% else %}true{% endif %}"
      style="height: {% if block.settings.open_by_default %}auto{% else %}0px{% endif %};"
    >
      <div class="claims-certifications__content-inner">
        {% if claim.icon.value != blank %}
          <div class="claims-certifications__icons" aria-label="Certification icons">
            {% for claim_icon in claim.icon.value %}
              {{
                claim_icon
                | image_url: width: 200
                | image_tag:
                  class: 'claims-certifications__icon',
                  loading: 'lazy',
                  widths: '48, 96, 144, 200',
                  sizes: '64px'
              }}
            {% endfor %}
          </div>
        {% endif %}

        {% if claim.name != blank %}
          <h3 class="claims-certifications__name">{{ claim.name }}</h3>
        {% endif %}

        <dl class="claims-certifications__details">
          {% if claim.type != blank %}
            <div><dt>Type</dt><dd>{{ claim.type }}</dd></div>
          {% endif %}
          {% if claim.verification_note != blank %}
            <div><dt>Verification note</dt><dd>{{ claim.verification_note }}</dd></div>
          {% endif %}
        </dl>

        {% if claim.short_description != blank %}
          <div class="claims-certifications__description rte">
            {{ claim.short_description | metafield_tag }}
          </div>
        {% endif %}

        {% if claim.certificate.value != blank %}
          <a
            class="claims-certifications__download"
            href="{{ claim.certificate.value.url }}"
            download
          >
            {{ block.settings.download_label | escape }}
          </a>
        {% endif %}
      </div>
    </div>
  </claims-certifications-accordion>

  <script>
    if (!customElements.get('claims-certifications-accordion')) {
      customElements.define(
        'claims-certifications-accordion',
        class extends HTMLElement {
          connectedCallback() {
            this.button = this.querySelector('.claims-certifications__toggle');
            this.content = this.querySelector('.claims-certifications__content');
            if (!this.button || !this.content) return;

            this.button.addEventListener('click', () => this.toggle());
            this.content.addEventListener('transitionend', (event) => {
              if (event.propertyName === 'height' && this.button.getAttribute('aria-expanded') === 'true') {
                this.content.style.height = 'auto';
              }
            });
          }

          toggle() {
            const isOpen = this.button.getAttribute('aria-expanded') === 'true';
            this.button.setAttribute('aria-expanded', String(!isOpen));
            this.content.setAttribute('aria-hidden', String(isOpen));

            if (isOpen) {
              this.content.style.height = `${this.content.scrollHeight}px`;
              requestAnimationFrame(() => {
                this.content.style.height = '0px';
              });
            } else {
              this.content.style.height = `${this.content.scrollHeight}px`;
            }
          }
        }
      );
    }
  </script>
{% endif %}

{% stylesheet %}
  .claims-certifications {
    display: block;
    border-block: 1px solid rgb(var(--color-foreground-rgb) / 0.2);
  }

  .claims-certifications__toggle {
    appearance: none;
    width: 100%;
    padding: 16px 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    color: inherit;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font: inherit;
    font-weight: 600;
    text-align: left;
    cursor: pointer;
  }

  .claims-certifications__symbol {
    position: relative;
    flex: 0 0 16px;
    width: 16px;
    height: 16px;
  }

  .claims-certifications__symbol::before,
  .claims-certifications__symbol::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    width: 16px;
    height: 1px;
    background: currentColor;
    transform: translateY(-50%);
  }

  .claims-certifications__symbol::after {
    transform: translateY(-50%) rotate(90deg);
    transition: transform 200ms ease;
  }

  .claims-certifications__toggle[aria-expanded='true'] .claims-certifications__symbol::after {
    transform: translateY(-50%) rotate(0deg);
  }

  .claims-certifications__content {
    overflow: hidden;
    transition: height 300ms ease;
  }

  .claims-certifications__content-inner {
    padding-block: 0 20px;
  }

  .claims-certifications__icons {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-block-end: 16px;
  }

  .claims-certifications__icon {
    display: block;
    width: 64px;
    height: 64px;
    object-fit: contain;
    border-radius: 0;
  }

  .claims-certifications__name {
    margin: 0 0 12px;
  }

  .claims-certifications__details {
    margin: 0;
  }

  .claims-certifications__details > div {
    display: grid;
    grid-template-columns: minmax(140px, 0.4fr) 1fr;
    gap: 12px;
    padding-block: 8px;
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / 0.12);
  }

  .claims-certifications__details dt {
    font-weight: 600;
  }

  .claims-certifications__details dd {
    margin: 0;
  }

  .claims-certifications__description,
  .claims-certifications__download {
    margin-block-start: 16px;
  }

  .claims-certifications__download {
    display: inline-block;
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (prefers-reduced-motion: reduce) {
    .claims-certifications__content,
    .claims-certifications__symbol::after {
      transition-duration: 0.01ms;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Claims & Certifications",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Claims & Certifications"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    },
    {
      "type": "text",
      "id": "download_label",
      "label": "Certificate link label",
      "default": "Download certificate"
    }
  ],
  "presets": [
    {
      "name": "Claims & Certifications",
      "category": "Product"
    }
  ]
}
{% endschema %}
