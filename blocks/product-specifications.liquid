{% liquid
  assign product_resource = closest.product | default: product
  assign structure_details = product_resource.metafields.custom.structure_details
  assign silhouette = product_resource.metafields.custom.silhouette
  assign movement_rating = product_resource.metafields.custom.movement_rating
  assign sheer_opaque = product_resource.metafields.custom.sheer_opaque
  assign stitching_type = product_resource.metafields.custom.stitching_type
  assign neckline = product_resource.metafields.custom.neckline
  assign sleeve_type = product_resource.metafields.custom.sleeve_type
  assign separate_sleeve_attached = product_resource.metafields.custom.separate_sleeve_attached | default: product_resource.metafields.custom.seperate_sleeve_attached
  assign closure_type = product_resource.metafields.custom.closure_type
  assign back_design = product_resource.metafields.custom.back_design
  assign lining_details = product_resource.metafields.custom.lining_details
  assign fabric_gsm = product_resource.metafields.custom.fabric_gsm
  assign fabric_type = product_resource.metafields.custom.fabric_type
  assign fall_pico = product_resource.metafields.custom.fall_pico
  assign fit_note = product_resource.metafields.custom.fit_note
  assign dimensions_summary = product_resource.metafields.custom.dimensions_summary
  assign lehenga_length = product_resource.metafields.custom.lehenga_length
  assign waist_dimension = product_resource.metafields.custom.waist_dimension
  assign included_items = product_resource.metafields.custom.included_items
  assign component_fabrics = product_resource.metafields.custom.component_fabrics
  assign key_details = product_resource.metafields.custom.key_details

  assign has_specifications = false
  if structure_details.value != blank or silhouette.value != blank or movement_rating.value != blank or sheer_opaque.value != blank or stitching_type.value != blank or neckline.value != blank or sleeve_type.value != blank or separate_sleeve_attached.value != blank or closure_type.value != blank or back_design.value != blank or lining_details.value != blank or fabric_gsm.value != blank or fabric_type.value != blank or fall_pico.value != blank or fit_note.value != blank or dimensions_summary.value != blank or lehenga_length.value != blank or waist_dimension.value != blank or included_items.value != blank or component_fabrics.value != blank or key_details.value != blank
    assign has_specifications = true
  endif
%}

{% if has_specifications %}
  {{ 'metaobject-accordion.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'metaobject-accordion.js' | asset_url }}" defer="defer"></script>

  <metaobject-accordion class="metaobject-accordion" style="--pdb-margin-top: {{ block.settings.margin_top }}px; --pdb-margin-bottom: {{ block.settings.margin_bottom }}px; --pdb-margin-inline: {{ block.settings.margin_inline }}px; --pdb-padding-block: {{ block.settings.padding_vertical }}px; --pdb-padding-inline: {{ block.settings.padding_horizontal }}px; --pdb-background: {{ block.settings.background_color }}; --pdb-surface: {{ block.settings.surface_color }}; --pdb-text: {{ block.settings.text_color }}; --pdb-muted: {{ block.settings.muted_color }}; --pdb-accent: {{ block.settings.accent_color }}; --pdb-border: {{ block.settings.border_color }};" {{ block.shopify_attributes }}>
    <button
      class="metaobject-accordion__toggle"
      type="button"
      aria-expanded="{% if block.settings.open_by_default %}true{% else %}false{% endif %}"
      aria-controls="ProductSpecificationsContent-{{ block.id }}"
    >
      <span>{{ block.settings.heading | escape }}</span>
      <span class="metaobject-accordion__symbol" aria-hidden="true"></span>
    </button>

    <div
      id="ProductSpecificationsContent-{{ block.id }}"
      class="metaobject-accordion__content"
      aria-hidden="{% if block.settings.open_by_default %}false{% else %}true{% endif %}"
      style="height: {% if block.settings.open_by_default %}auto{% else %}0px{% endif %};"
    >
      <div class="metaobject-accordion__content-inner">
        <dl class="metaobject-accordion__details">
          {% if structure_details.value != blank %}<div><dt>Structure Details</dt><dd>{{ structure_details.value | escape | newline_to_br }}</dd></div>{% endif %}
          {% if silhouette.value != blank %}<div><dt>Silhouette</dt><dd>{{ silhouette.value | escape | newline_to_br }}</dd></div>{% endif %}
          {% if movement_rating.value != blank %}<div><dt>Movement Rating</dt><dd>{{ movement_rating.value | escape | newline_to_br }}</dd></div>{% endif %}
          {% if sheer_opaque.value != blank %}<div><dt>Sheer / Opaque</dt><dd>{{ sheer_opaque.value | escape | newline_to_br }}</dd></div>{% endif %}
          {% if stitching_type.value != blank %}<div><dt>Stitching Type</dt><dd>{{ stitching_type.value | escape | newline_to_br }}</dd></div>{% endif %}
          {% if neckline.value != blank %}<div><dt>Neckline</dt><dd>{{ neckline.value | escape | newline_to_br }}</dd></div>{% endif %}
          {% if sleeve_type.value != blank %}<div><dt>Sleeve Type</dt><dd>{{ sleeve_type.value | escape | newline_to_br }}</dd></div>{% endif %}
          {% if separate_sleeve_attached.value != blank %}<div><dt>Separate Sleeve Attached</dt><dd>{{ separate_sleeve_attached.value | escape | newline_to_br }}</dd></div>{% endif %}
          {% if closure_type.value != blank %}<div><dt>Closure Type</dt><dd>{{ closure_type.value | escape | newline_to_br }}</dd></div>{% endif %}
          {% if back_design.value != blank %}<div><dt>Back Design</dt><dd>{{ back_design.value | escape | newline_to_br }}</dd></div>{% endif %}
          {% if lining_details.value != blank %}<div><dt>Lining Details</dt><dd>{{ lining_details.value | escape | newline_to_br }}</dd></div>{% endif %}
          {% if fabric_gsm.value != blank %}<div><dt>Fabric GSM</dt><dd>{{ fabric_gsm.value | escape | newline_to_br }}</dd></div>{% endif %}
          {% if fabric_type.value != blank %}<div><dt>Fabric Type</dt><dd>{{ fabric_type.value | escape | newline_to_br }}</dd></div>{% endif %}
          {% if fall_pico.value != blank %}<div><dt>Fall/Pico</dt><dd>{{ fall_pico.value | escape | newline_to_br }}</dd></div>{% endif %}
          {% if fit_note.value != blank %}<div><dt>Fit Note</dt><dd>{{ fit_note.value | escape | newline_to_br }}</dd></div>{% endif %}
          {% if dimensions_summary.value != blank %}<div><dt>Dimensions Summary</dt><dd>{{ dimensions_summary.value | escape | newline_to_br }}</dd></div>{% endif %}
          {% if lehenga_length.value != blank %}<div><dt>Lehenga Length</dt><dd>{{ lehenga_length.value | escape | newline_to_br }}</dd></div>{% endif %}
          {% if waist_dimension.value != blank %}<div><dt>Waist Dimension</dt><dd>{{ waist_dimension.value | escape | newline_to_br }}</dd></div>{% endif %}
          {% if included_items.value != blank %}
            <div>
              <dt>Included Items</dt>
              <dd>
                <ul class="metaobject-accordion__value-list">
                  {% for included_item in included_items.value %}
                    {% if included_item != blank %}<li>{{ included_item | escape }}</li>{% endif %}
                  {% endfor %}
                </ul>
              </dd>
            </div>
          {% endif %}
          {% if component_fabrics.value != blank %}
            <div>
              <dt>Component Fabrics</dt>
              <dd>
                <ul class="metaobject-accordion__value-list">
                  {% for component_fabric in component_fabrics.value %}
                    {% if component_fabric != blank %}<li>{{ component_fabric | escape }}</li>{% endif %}
                  {% endfor %}
                </ul>
              </dd>
            </div>
          {% endif %}
          {% if key_details.value != blank %}
            <div>
              <dt>Key Details</dt>
              <dd>
                <ul class="metaobject-accordion__value-list">
                  {% for key_detail in key_details.value %}
                    {% if key_detail != blank %}<li>{{ key_detail | escape }}</li>{% endif %}
                  {% endfor %}
                </ul>
              </dd>
            </div>
          {% endif %}
        </dl>
      </div>
    </div>
  </metaobject-accordion>
{% endif %}

{% schema %}
{
  "name": "Product Specifications",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product Specifications"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Open by default",
      "default": false
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "margin_top", "label": "Margin top", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "margin_bottom", "label": "Margin bottom", "min": 0, "max": 100, "step": 2, "unit": "px", "default": 12 },
    { "type": "range", "id": "margin_inline", "label": "Side margins", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_vertical", "label": "Inner vertical spacing", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 4 },
    { "type": "range", "id": "padding_horizontal", "label": "Inner side spacing", "min": 8, "max": 36, "step": 2, "unit": "px", "default": 16 }
    ,{ "type": "header", "content": "Colors" }
    ,{ "type": "color", "id": "background_color", "label": "Background", "default": "#fffaf3" }
    ,{ "type": "color", "id": "surface_color", "label": "Detail surface", "default": "#f7efe4" }
    ,{ "type": "color", "id": "text_color", "label": "Heading and labels", "default": "#3d1f15" }
    ,{ "type": "color", "id": "muted_color", "label": "Detail text", "default": "#765f55" }
    ,{ "type": "color", "id": "accent_color", "label": "Accent and icon", "default": "#a84e2c" }
    ,{ "type": "color", "id": "border_color", "label": "Borders", "default": "#dfd0bf" }
  ],
  "presets": [
    {
      "name": "Product Specifications",
      "category": "Product"
    }
  ]
}
{% endschema %}
