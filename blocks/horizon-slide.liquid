{% liquid
  assign is_first_slide = false
  if section.blocks.first.id == block.id
    assign is_first_slide = true
  endif

  assign image_loading = 'lazy'
  assign image_fetchpriority = 'low'
  if is_first_slide
    assign image_loading = 'eager'
    assign image_fetchpriority = 'high'
  endif

  assign slide_alt = block.settings.alt
  if slide_alt == blank and block.settings.desktop_image != blank
    assign slide_alt = block.settings.desktop_image.alt
  endif
  if slide_alt == blank and block.settings.mobile_image != blank
    assign slide_alt = block.settings.mobile_image.alt
  endif
%}

<div class="splide__slide slider__banner-wrap-custom" {{ block.shopify_attributes }}>
  <div class="slider__imagcontent-box">
    <!-- MEDIA -->
    <div class="customsliderimage__container-all">
      <div class="banners_images-custom">
        {% if block.settings.content_type == 'image' %}
          {% if block.settings.desktop_image != blank %}
            <picture>
              {% if block.settings.mobile_image != blank %}
                <source
                  media="(max-width: 749px)"
                  srcset="
                    {{ block.settings.mobile_image | image_url: width: 375 }} 375w,
                    {{ block.settings.mobile_image | image_url: width: 550 }} 550w,
                    {{ block.settings.mobile_image | image_url: width: 750 }} 750w,
                    {{ block.settings.mobile_image | image_url: width: 1000 }} 1000w
                  "
                  sizes="100vw"
                  width="{{ block.settings.mobile_image.width }}"
                  height="{{ block.settings.mobile_image.height }}"
                >
              {% endif %}
              {{
                block.settings.desktop_image
                | image_url: width: 2400
                | image_tag:
                  class: 'customslider',
                  widths: '750, 1100, 1500, 1920, 2400',
                  sizes: '100vw',
                  loading: image_loading,
                  fetchpriority: image_fetchpriority,
                  alt: slide_alt
              }}
            </picture>
          {% elsif block.settings.mobile_image != blank %}
            {{
              block.settings.mobile_image
              | image_url: width: 1000
              | image_tag:
                class: 'customslider',
                widths: '375, 550, 750, 1000',
                sizes: '100vw',
                loading: image_loading,
                fetchpriority: image_fetchpriority,
                alt: slide_alt
            }}
          {% else %}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__media' }}
          {% endif %}

        {% elsif block.settings.content_type == 'video' %}
          {% if block.settings.video != blank %}
            <div
              class="video__hero-wrap"
              style="
                --slider-video-height-desktop: {{ block.settings.height_desktop }}px;
                --slider-video-height-mobile: {{ block.settings.height_mobile }}px;
              "
            >
              {{
                block.settings.video
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  preload: true,
                  class: 'custom-video_content'
              }}
            </div>
          {% else %}
            {{ 'hero-apparel-1' | placeholder_svg_tag: 'hero__media' }}
          {% endif %}
        {% endif %}
      </div>
    </div>

    <!-- OVERLAY -->
    {% if block.settings.overlay_opacity > 0 %}
      <div
        class="customskideroverlay__container-all"
        style="
          --slider-overlay-background: {{ block.settings.overlay_color }};
          --slider-overlay-opacity: {{ block.settings.overlay_opacity }}%;
        "
      ></div>
    {% endif %}

    {% if block.settings.url != blank %}
      <a
        class="customskiderurl__container-all"
        href="{{ block.settings.url }}"
        aria-label="{{ slide_alt | default: 'View slide' | escape }}"
        {% if block.settings.new_tab %}
          target="_blank"
          rel="noopener noreferrer"
        {% endif %}
      ></a>
    {% endif %}

    <!-- CONTENT -->
    <div class="custom-hero-full">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero Slide",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "content_type",
      "label": "Content Type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video" }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Image alt text"
    },
    {
      "type": "url",
      "label": "Slide Url",
      "id": "url"
    },
    {
      "type": "checkbox",
      "label": "Open Url in new tab",
      "id": "new_tab",
      "default": false
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video"
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "Video height (Desktop)",
      "min": 0,
      "max": 1000,
      "step": 10,
      "default": 450
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Video height (Mobile)",
      "min": 0,
      "max": 1000,
      "step": 10,
      "default": 450
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 10,
      "default": 30
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Hero Slide"
    }
  ]
}
{% endschema %}
