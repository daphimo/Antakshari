{{ 'testimonials-slider.css' | asset_url | stylesheet_tag }}

<testimonial-video-popup data-section-id="{{ section.id }}">
<section
  class="testimonials-slider"
  style="
    --testimonials-background: {{ section.settings.background_color }};
    --testimonials-text: {{ section.settings.text_color }};
    --testimonials-accent: {{ section.settings.accent_color }};
    --testimonials-media-height: {{ section.settings.media_height }}px;
    --testimonials-media-height-mobile: {{ section.settings.media_height_mobile }}px;
    --testimonials-radius: {{ section.settings.card_radius }}px;
    --testimonials-max-width: {{ section.settings.section_max_width }}px;
    --testimonials-padding-inline: {{ section.settings.padding_inline }}px;
    --testimonials-column-gap: {{ section.settings.column_gap }}px;
    --testimonials-padding-top: {{ section.settings.padding_top }}px;
    --testimonials-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="testimonials-slider__inner">
    <header class="testimonials-slider__intro">
      {% if section.settings.eyebrow != blank %}
        <p class="testimonials-slider__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="testimonials-slider__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.description != blank %}
        <div class="testimonials-slider__description">{{ section.settings.description }}</div>
      {% endif %}
    </header>

    <div id="splide-{{ section.id }}" class="splide testimonials-slider__splide">
      <div class="splide__track">
        <ul class="splide__list">
          {% for block in section.blocks %}
            <li
              class="splide__slide testimonials-slider__slide"
              data-block-id="{{ block.id }}"
              data-slide-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              <div class="testimonials-slider__media">
                {% if block.settings.video != blank %}
                  {% assign video_alt = block.settings.alt_text | default: block.settings.video.alt | escape %}
                  {{
                    block.settings.video
                    | video_tag:
                      autoplay: true,
                      loop: true,
                      muted: true,
                      controls: false,
                      playsinline: true,
                      preload: 'metadata',
                      class: 'testimonials-slider__video',
                      aria-label: video_alt
                  }}
                  <button class="testimonials-slider__open" type="button" data-video-index="{{ forloop.index0 }}" aria-haspopup="dialog" aria-controls="testimonial-popup-{{ section.id }}" aria-label="Open testimonial video {{ forloop.index }}{% if video_alt != blank %}: {{ video_alt }}{% endif %}"></button>
                {% endif %}
              </div>
            </li>
          {% else %}
            <li class="splide__slide testimonials-slider__slide">
              <div class="testimonials-slider__media"></div>
            </li>
          {% endfor %}
        </ul>
      </div>

      {% if section.settings.show_arrows and section.blocks.size > 1 %}
        <div class="splide__arrows testimonials-slider__arrows">
          <button class="splide__arrow splide__arrow--prev" type="button" aria-label="Previous testimonial">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
          </button>
          <button class="splide__arrow splide__arrow--next" type="button" aria-label="Next testimonial">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
        </div>
      {% endif %}
    </div>
  </div>
</section>

<dialog id="testimonial-popup-{{ section.id }}" class="testimonial-popup" role="dialog" aria-modal="true" aria-label="Testimonials videos">
  <button class="testimonial-popup__button testimonial-popup__close" type="button" data-close aria-label="Close" autofocus>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
  </button>
  <div class="testimonial-popup__feed" tabindex="0" aria-label="Scroll for more testimonial videos">
    {% for block in section.blocks %}
      {% if block.settings.video != blank %}
        <div class="testimonial-popup__item" data-video-index="{{ forloop.index0 }}" role="group" aria-label="Testimonial video {{ forloop.index }}">
          <template>
            {% assign popup_alt = block.settings.alt_text | default: block.settings.video.alt | escape %}
            {{ block.settings.video | video_tag: loop: true, muted: true, playsinline: true, controls: false, preload: 'none', class: 'testimonial-popup__video', aria-label: popup_alt }}
          </template>
          <progress class="testimonial-popup__progress" max="100" value="0" aria-label="Video playback progress"></progress>
          <div class="testimonial-popup__controls" inert>
            <button class="testimonial-popup__button" type="button" data-play aria-label="Play">
              <svg data-icon="play" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 5 11 7-11 7Z"/></svg>
              <svg data-icon="pause" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M9 5v14M15 5v14"/></svg>
            </button>
            <button class="testimonial-popup__button" type="button" data-mute aria-label="Unmute">
              <svg data-icon="muted" viewBox="0 0 24 24" aria-hidden="true"><path d="M11 5 6 9H3v6h3l5 4ZM16 9l6 6m0-6-6 6"/></svg>
              <svg data-icon="unmuted" viewBox="0 0 24 24" aria-hidden="true" hidden><path d="M11 5 6 9H3v6h3l5 4ZM15 8a6 6 0 0 1 0 8m3-11a10 10 0 0 1 0 14"/></svg>
            </button>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</dialog>
</testimonial-video-popup>

{% stylesheet %}
  testimonial-video-popup { display: block; }
  .testimonials-slider__open { position: absolute; inset: 0; width: 100%; height: 100%; padding: 0; border: 0; border-radius: inherit; background: transparent; cursor: pointer; }
  .testimonials-slider__open:focus-visible { outline: 3px solid currentColor; outline-offset: -4px; }
  .testimonial-popup { --popup-gutter-top: max(32px, env(safe-area-inset-top)); --popup-gutter-bottom: max(32px, env(safe-area-inset-bottom)); position: fixed; inset: 0; width: 100%; max-width: none; height: 100vh; height: 100dvh; max-height: none; margin: 0; padding: 0; border: 0; background: transparent; color: #fff; overflow: hidden; }
  .testimonial-popup::backdrop { background: rgb(0 0 0 / 70%); }
  .testimonial-popup__feed { height: 100%; width: 100%; overflow-y: auto; overflow-x: hidden; scroll-snap-type: y mandatory; overscroll-behavior: contain; touch-action: pan-y; scrollbar-width: none; }
  .testimonial-popup__feed::-webkit-scrollbar { display: none; }
  .testimonial-popup__item { position: relative; width: 100%; max-width: 560px; height: 100vh; height: 100dvh; box-sizing: border-box; padding-block: var(--popup-gutter-top) var(--popup-gutter-bottom); margin-inline: auto; scroll-snap-align: start; scroll-snap-stop: always; background: transparent; }
  .testimonial-popup__video { display: block; width: 100%; height: 100%; max-height: 100%; object-fit: cover; background: #000; border-radius: 12px; }
  .testimonial-popup__controls { position: absolute; inset: auto 0 var(--popup-gutter-bottom); border-radius: 0 0 12px 12px; display: flex; justify-content: flex-end; gap: 12px; padding: 48px 20px max(24px, env(safe-area-inset-bottom)); background: linear-gradient(transparent, rgb(0 0 0 / 55%)); pointer-events: none; }
  .testimonial-popup__progress { position: absolute; z-index: 1; bottom: calc(var(--popup-gutter-bottom) + 8px); left: 12px; display: block; width: calc(100% - 24px); height: 3px; border: 0; border-radius: 999px; overflow: hidden; appearance: none; background: rgb(255 255 255 / 30%); color: #fff; pointer-events: none; }
  .testimonial-popup__progress::-webkit-progress-bar { background: rgb(255 255 255 / 30%); border-radius: 999px; }
  .testimonial-popup__progress::-webkit-progress-value { background: #fff; border-radius: 999px; }
  .testimonial-popup__progress::-moz-progress-bar { background: #fff; border-radius: 999px; }
  .testimonial-popup__controls[inert] { visibility: hidden; }
  .testimonial-popup__button { display: grid; place-items: center; width: 48px; height: 48px; padding: 12px; border: 1px solid rgb(255 255 255 / 20%); border-radius: 50%; background: rgb(20 20 20 / 65%); color: #fff; cursor: pointer; pointer-events: auto; }
  .testimonial-popup__button svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .testimonial-popup__button svg[hidden] { display: none; }
  .testimonial-popup__close { position: absolute; top: max(16px, env(safe-area-inset-top)); right: max(16px, env(safe-area-inset-right)); z-index: 2; }
  .testimonial-popup__button:focus-visible, .testimonial-popup__feed:focus-visible { outline: 2px solid white; outline-offset: -4px; }
  @media (max-width: 768px) { .testimonial-popup { --popup-gutter-top: max(24px, env(safe-area-inset-top)); --popup-gutter-bottom: max(24px, env(safe-area-inset-bottom)); } .testimonial-popup__item { max-width: none; } }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('testimonial-video-popup')) {
    customElements.define('testimonial-video-popup', class extends HTMLElement {
      connectedCallback() {
        if (this.abort) return;
        this.abort = new AbortController();
        const options = { signal: this.abort.signal };
        this.dialog = this.querySelector('dialog');
        this.feed = this.querySelector('.testimonial-popup__feed');
        this.items = [...this.feed.querySelectorAll('.testimonial-popup__item')];
        this.addEventListener('click', (event) => {
          const trigger = event.target.closest('[data-video-index].testimonials-slider__open');
          if (trigger) {
            event.preventDefault();
            event.stopPropagation();
            this.open(trigger);
          }
        }, options);
        this.dialog.addEventListener('click', (event) => {
          if (event.target.closest('[data-close]')) {
            this.dialog.close();
            return;
          }
          const video = this.active?.querySelector('video');
          if (!video) return;
          if (event.target.closest('[data-mute]')) video.muted = !video.muted;
          if (event.target.closest('[data-play]') || event.target === video) {
            if (video.paused) this.play(video);
            else video.pause();
          }
          this.update(video);
        }, options);
        this.dialog.addEventListener('close', () => this.cleanup(), options);
        this.dialog.addEventListener('cancel', (event) => {
          event.preventDefault();
          this.dialog.close();
        }, options);
        this.observer = new IntersectionObserver((entries) => {
          if (!this.dialog.open) return;
          const visible = entries.filter(entry => entry.intersectionRatio > 0.5)
            .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
          if (visible) this.activate(visible.target);
        }, { root: this.feed, threshold: [0, 0.5, 0.75, 1] });
      }
      play(video) {
        const promise = video.play();
        if (promise) promise.then(() => this.update(video), () => this.update(video));
      }
      updateProgress(video) {
        const progress = video.closest('.testimonial-popup__item').querySelector('.testimonial-popup__progress');
        progress.value = Number.isFinite(video.duration) && video.duration > 0
          ? Math.min(100, Math.max(0, video.currentTime / video.duration * 100))
          : 0;
      }
      update(video) {
        const item = video.closest('.testimonial-popup__item');
        item.querySelector('[data-play]').setAttribute('aria-label', video.paused ? 'Play' : 'Pause');
        item.querySelector('[data-mute]').setAttribute('aria-label', video.muted ? 'Unmute' : 'Mute');
        item.querySelector('[data-icon="play"]').toggleAttribute('hidden', !video.paused);
        item.querySelector('[data-icon="pause"]').toggleAttribute('hidden', video.paused);
        item.querySelector('[data-icon="muted"]').toggleAttribute('hidden', !video.muted);
        item.querySelector('[data-icon="unmuted"]').toggleAttribute('hidden', video.muted);
      }
      activate(item) {
        if (this.active === item) return;
        this.items.forEach(other => {
          other.querySelector('.testimonial-popup__controls').inert = other !== item;
          const video = other.querySelector('video');
          if (video) { video.pause(); video.autoplay = false; }
        });
        this.active = item;
        let video = item.querySelector('video');
        if (!video) {
          item.prepend(item.querySelector('template').content.cloneNode(true));
          video = item.querySelector('video');
          ['timeupdate', 'loadedmetadata', 'durationchange', 'emptied', 'ended'].forEach(name => video.addEventListener(name, () => this.updateProgress(video), { signal: this.abort.signal }));
          ['play', 'pause', 'volumechange'].forEach(name => video.addEventListener(name, () => this.update(video), { signal: this.abort.signal }));
        }
        video.muted = true;
        video.autoplay = true;
        this.updateProgress(video);
        this.update(video);
        this.play(video);
      }
      open(trigger) {
        const item = this.items.find(item => item.dataset.videoIndex === trigger.dataset.videoIndex);
        if (!item || this.dialog.open) return;
        document.querySelectorAll('testimonial-video-popup').forEach(other => {
          if (other !== this && other.dialog?.open) other.dialog.close();
          if (other !== this && other.lock) other.cleanup();
        });
        this.returnFocus = trigger;
        this.dialog.showModal();
        const body = document.body;
        this.lock = { x: window.scrollX, y: window.scrollY, styles: ['position', 'top', 'left', 'width', 'overflow'].map(name => [name, body.style.getPropertyValue(name), body.style.getPropertyPriority(name)]) };
        body.style.position = 'fixed';
        body.style.top = `-${this.lock.y}px`;
        body.style.left = `-${this.lock.x}px`;
        body.style.width = '100%';
        body.style.overflow = 'hidden';
        this.backgroundVideos = [...document.querySelectorAll('.testimonials-slider__video')];
        this.pauseBackground = event => event.target.pause();
        this.backgroundVideos.forEach(video => { video.pause(); video.addEventListener('play', this.pauseBackground); });
        this.feed.scrollTop = item.offsetTop;
        this.activate(item);
        this.items.forEach(item => this.observer.observe(item));
        this.dialog.querySelector('[data-close]').focus({ preventScroll: true });
      }
      cleanup() {
        this.observer?.disconnect();
        this.items.forEach(item => {
          const video = item.querySelector('video');
          if (video) { video.pause(); video.autoplay = false; video.muted = true; }
          item.querySelector('.testimonial-popup__controls').inert = true;
        });
        this.active = null;
        if (!this.lock) return;
        const { x, y, styles } = this.lock;
        styles.forEach(([name, value, priority]) => {
          if (value) document.body.style.setProperty(name, value, priority);
          else document.body.style.removeProperty(name);
        });
        this.lock = null;
        window.scrollTo({ left: x, top: y, behavior: 'instant' });
        this.backgroundVideos.forEach(video => {
          video.removeEventListener('play', this.pauseBackground);
          if (video.isConnected) { video.muted = true; const promise = video.play(); if (promise) promise.catch(() => {}); }
        });
        if (this.returnFocus?.isConnected) this.returnFocus.focus({ preventScroll: true });
      }
      disconnectedCallback() {
        this.dialog?.close();
        this.cleanup();
        this.abort?.abort();
        this.abort = null;
      }
    });
  }
{% endjavascript %}

{% render 'splide-slider', slider_id: section.id, section_id: section.id, slider_type: 'loop' %}

{% schema %}
{
  "name": "Testimonials slider",
  "tag": "section",
  "class": "section-testimonials-slider",
  "max_blocks": 30,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Loved by you" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stories from our community" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Thoughtful pieces, made memorable by the people who wear them. Discover what our community has to say.</p>" },
    { "type": "range", "id": "media_height", "label": "Desktop media height", "min": 320, "max": 720, "step": 20, "unit": "px", "default": 520 },
    { "type": "range", "id": "media_height_mobile", "label": "Mobile media height", "min": 220, "max": 520, "step": 20, "unit": "px", "default": 340 },
    { "type": "range", "id": "section_max_width", "label": "Page width", "min": 1000, "max": 2000, "step": 50, "unit": "px", "default": 1600 },
    { "type": "range", "id": "padding_inline", "label": "Horizontal padding", "min": 16, "max": 80, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "column_gap", "label": "Column gap", "min": 20, "max": 100, "step": 4, "unit": "px", "default": 60 },
    { "type": "range", "id": "card_radius", "label": "Video corner radius", "min": 0, "max": 36, "step": 2, "unit": "px", "default": 24 },
    { "type": "color", "id": "background_color", "label": "Section background", "default": "#faf5eb" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#4a1d0e" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#e8a53a" },
    { "type": "checkbox", "id": "autoplay", "label": "Autoplay slides", "default": false },
    { "type": "range", "id": "autoplay_speed", "label": "Autoplay speed", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 6 },
    { "type": "range", "id": "transition_speed", "label": "Transition speed", "min": 300, "max": 1200, "step": 100, "unit": "ms", "default": 600 },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "perPageDesktop", "label": "Desktop slides per view", "min": 1, "max": 6, "step": 0.5, "default": 1 },
    { "type": "range", "id": "perPageMobile", "label": "Mobile slides per view", "min": 1, "max": 3, "step": 0.5, "default": 1 },
    { "type": "range", "id": "perMove", "label": "Slides to move", "min": 1, "max": 3, "step": 1, "default": 1 },
    { "type": "range", "id": "gap", "label": "Slide gap", "min": 0, "max": 40, "step": 4, "unit": "px", "default": 16 },
    { "type": "range", "id": "gap_mobile", "label": "Mobile slide gap", "min": 0, "max": 24, "step": 4, "unit": "px", "default": 8 },
    { "type": "checkbox", "id": "show_arrows", "label": "Show desktop arrows", "default": true },
    { "type": "checkbox", "id": "show_pagination", "label": "Show pagination", "default": false }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "video", "id": "video", "label": "Video" },
        { "type": "text", "id": "alt_text", "label": "Video alt text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials slider",
      "category": "Promotional",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
