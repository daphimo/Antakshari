{{ 'premium-blog-posts.css' | asset_url | stylesheet_tag }}

{% liquid
  assign selected_blog = section.settings.blog
  if selected_blog == blank and blog != blank
    assign selected_blog = blog
  endif

  assign view_all_url = section.settings.view_all_link
  if view_all_url == blank and selected_blog != blank
    assign view_all_url = selected_blog.url
  endif
%}

<section
  class="premium-blog-posts premium-blog-posts--{{ section.settings.layout }}"
  style="
    --pbp-background: {{ section.settings.background }};
    --pbp-card-background: {{ section.settings.card_background }};
    --pbp-text: {{ section.settings.text_color }};
    --pbp-muted: {{ section.settings.muted_color }};
    --pbp-accent: {{ section.settings.accent_color }};
    --pbp-border: {{ section.settings.border_color }};
    --pbp-width: {{ section.settings.container_width }}px;
    --pbp-columns: {{ section.settings.columns }};
    --pbp-gap: {{ section.settings.card_gap }}px;
    --pbp-image-height: {{ section.settings.image_height }}px;
    --pbp-radius: {{ section.settings.card_radius }}px;
    --pbp-image-radius: {{ section.settings.image_radius }}px;
    --pbp-card-padding: {{ section.settings.card_padding }}px;
    --pbp-heading-size: {{ section.settings.heading_size }}px;
    --pbp-title-size: {{ section.settings.article_title_size }}px;
    --pbp-padding-top: {{ section.settings.padding_top }}px;
    --pbp-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="premium-blog-posts__inner">
    <header class="premium-blog-posts__header premium-blog-posts__header--{{ section.settings.header_alignment }}">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="premium-blog-posts__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <{{ section.settings.heading_tag }} class="premium-blog-posts__heading">{{ section.settings.heading | escape }}</{{ section.settings.heading_tag }}>
        {% endif %}
      </div>

      {% if section.settings.description != blank %}
        <div class="premium-blog-posts__description rte">{{ section.settings.description }}</div>
      {% endif %}
    </header>

    {% if selected_blog != blank and selected_blog.articles_count > 0 %}
      <div class="premium-blog-posts__grid">
        {% for article in selected_blog.articles limit: section.settings.articles_to_show %}
          <article class="premium-blog-card{% if section.settings.layout == 'featured' and forloop.first %} premium-blog-card--featured{% endif %}">
            <a class="premium-blog-card__media" href="{{ article.url }}" aria-label="{{ article.title | escape }}">
              {% if article.image != blank %}
                {{
                  article.image
                  | image_url: width: 1400
                  | image_tag:
                    class: 'premium-blog-card__image',
                    loading: 'lazy',
                    widths: '320, 480, 640, 800, 1000, 1200, 1400',
                    sizes: '(min-width: 1200px) 32vw, (min-width: 750px) 48vw, 100vw',
                    alt: article.image.alt | default: article.title
                }}
              {% else %}
                {{ 'image' | placeholder_svg_tag: 'premium-blog-card__image premium-blog-card__placeholder' }}
              {% endif %}

              <span class="premium-blog-card__shade" aria-hidden="true"></span>

              {% if section.settings.show_tag and article.tags.size > 0 %}
                <span class="premium-blog-card__tag">{{ article.tags.first | escape }}</span>
              {% endif %}
            </a>

            <div class="premium-blog-card__content">
              {% if section.settings.show_date or section.settings.show_author %}
                <div class="premium-blog-card__meta">
                  {% if section.settings.show_date %}
                    <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                      {{ article.published_at | date: section.settings.date_format }}
                    </time>
                  {% endif %}
                  {% if section.settings.show_date and section.settings.show_author %}<span aria-hidden="true">&bull;</span>{% endif %}
                  {% if section.settings.show_author %}<span>{{ article.author | escape }}</span>{% endif %}
                </div>
              {% endif %}

              <h3 class="premium-blog-card__title">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h3>

              {% if section.settings.show_excerpt %}
                <p class="premium-blog-card__excerpt">
                  {% if article.excerpt != blank %}
                    {{ article.excerpt | strip_html | truncatewords: section.settings.excerpt_words }}
                  {% else %}
                    {{ article.content | strip_html | truncatewords: section.settings.excerpt_words }}
                  {% endif %}
                </p>
              {% endif %}

              {% if section.settings.show_read_more %}
                <a class="premium-blog-card__link" href="{{ article.url }}">
                  <span>{{ section.settings.read_more_label | escape }}</span>
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
                </a>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>

      {% if section.settings.show_view_all and view_all_url != blank %}
        <div class="premium-blog-posts__footer">
          <a class="premium-blog-posts__view-all" href="{{ view_all_url }}">
            {{ section.settings.view_all_label | escape }}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
      {% endif %}
    {% else %}
      <div class="premium-blog-posts__empty">Select a blog containing published articles.</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Premium blog posts",
  "tag": "section",
  "class": "section-premium-blog-posts",
  "settings": [
    { "type": "blog", "id": "blog", "label": "Blog", "info": "Leave blank on a blog template to use the current blog." },
    { "type": "range", "id": "articles_to_show", "label": "Articles to show", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "grid", "label": "Uniform grid" }, { "value": "featured", "label": "Featured first article" }], "default": "featured" },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "header", "content": "Section header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stories, craft and celebration" },
    { "type": "select", "id": "heading_tag", "label": "Heading tag", "options": [{ "value": "h1", "label": "H1" }, { "value": "h2", "label": "H2" }, { "value": "h3", "label": "H3" }], "default": "h2" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Discover thoughtful stories, traditions and inspiration from our world.</p>" },
    { "type": "select", "id": "header_alignment", "label": "Header alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "header", "content": "Article content" },
    { "type": "checkbox", "id": "show_tag", "label": "Show first article tag", "default": true },
    { "type": "checkbox", "id": "show_date", "label": "Show publication date", "default": true },
    { "type": "checkbox", "id": "show_author", "label": "Show author", "default": false },
    { "type": "select", "id": "date_format", "label": "Date format", "options": [{ "value": "%b %d, %Y", "label": "Jan 01, 2026" }, { "value": "%B %d, %Y", "label": "January 01, 2026" }, { "value": "%d %b %Y", "label": "01 Jan 2026" }], "default": "%b %d, %Y" },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpt", "default": true },
    { "type": "range", "id": "excerpt_words", "label": "Excerpt length", "min": 8, "max": 50, "step": 1, "unit": "wrd", "default": 20 },
    { "type": "checkbox", "id": "show_read_more", "label": "Show article link", "default": true },
    { "type": "text", "id": "read_more_label", "label": "Article link label", "default": "Read story" },
    { "type": "checkbox", "id": "show_view_all", "label": "Show view-all link", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View-all label", "default": "Explore all stories" },
    { "type": "url", "id": "view_all_link", "label": "Custom view-all link", "info": "Leave blank to use the selected blog." },
    { "type": "header", "content": "Layout and cards" },
    { "type": "range", "id": "container_width", "label": "Container width", "min": 900, "max": 1800, "step": 20, "unit": "px", "default": 1400 },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 12, "max": 60, "step": 2, "unit": "px", "default": 26 },
    { "type": "range", "id": "image_height", "label": "Image height", "min": 200, "max": 600, "step": 20, "unit": "px", "default": 320 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 36, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "image_radius", "label": "Image radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 14 },
    { "type": "range", "id": "card_padding", "label": "Card padding", "min": 8, "max": 36, "step": 2, "unit": "px", "default": 12 },
    { "type": "header", "content": "Typography" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 28, "max": 72, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "article_title_size", "label": "Article title size", "min": 16, "max": 36, "step": 1, "unit": "px", "default": 23 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#faf6ee" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#fffaf3" },
    { "type": "color", "id": "text_color", "label": "Heading and titles", "default": "#3d1f15" },
    { "type": "color", "id": "muted_color", "label": "Description and excerpt", "default": "#755b50" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#b55f37" },
    { "type": "color", "id": "border_color", "label": "Card border", "default": "#e2d3c2" },
    { "type": "header", "content": "Section spacing" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 20, "max": 160, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 20, "max": 160, "step": 4, "unit": "px", "default": 88 }
  ],
  "presets": [{ "name": "Premium blog posts" }]
}
{% endschema %}
