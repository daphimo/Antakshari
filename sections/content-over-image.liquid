<div class="content-over-image" style="--content-image-max-width: {{ section.settings.max_width }}px; --content-image-items: {{ section.settings.desktop_items }};">
  <div class="content-over-image__inner">
    {% for block in section.blocks %}
      {% liquid
        assign image_alt = block.settings.alt_text | default: block.settings.image.alt
        if image_alt == blank and block.settings.link != blank
          assign image_alt = page.title | default: shop.name
        endif
      %}
      <div class="content-over-image__item" {{ block.shopify_attributes }}>
        {% if block.settings.image != blank %}
          {% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{% endif %}
            {% capture image_sizes %}(max-width: 749px) calc(100vw - 40px), min({{ section.settings.max_width }}px, {{ 100 | divided_by: section.settings.desktop_items }}vw){% endcapture %}
            {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '360, 540, 750, 1100, 1500, 1800, 2400', sizes: image_sizes, alt: image_alt, loading: 'lazy' }}
          {% if block.settings.link != blank %}</a>{% endif %}
        {% elsif request.design_mode %}
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        {% endif %}
      </div>
    {% endfor %}
  </div>
</div>
{% stylesheet %}
  .content-over-image { background: #FCFAF5; padding-block: 32px; }
  .content-over-image__inner { display: flex; flex-wrap: wrap; gap: 24px; box-sizing: border-box; width: 100%; max-width: var(--content-image-max-width); margin-inline: auto; padding-inline: 32px; }
  .content-over-image__item { flex: 0 0 calc((100% - (var(--content-image-items) - 1) * 24px) / var(--content-image-items)); min-width: 0; }
  .content-over-image__item a { display: block; border-radius: 6px; }
  .content-over-image__item img, .content-over-image__item svg { display: block; width: 100%; height: auto; border-radius: 6px; }
  .content-over-image__item a:focus-visible { outline: 2px solid #6B1F2A; outline-offset: 3px; }
  @media (max-width: 749px) {
    .content-over-image { padding-block: 24px; }
    .content-over-image__inner { padding-inline: 20px; gap: 20px; }
    .content-over-image__item { flex-basis: 100%; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Content over image",
  "max_blocks": 12,
  "settings": [
    {
      "type": "select",
      "id": "desktop_items",
      "label": "Desktop items per view",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 800,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1400
    }
  ],
  "blocks": [
    {
      "type": "promotion",
      "name": "Promotional image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Image link"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Content over image",
      "category": "Promotional",
      "blocks": [
        {
          "type": "promotion"
        },
        {
          "type": "promotion"
        }
      ]
    }
  ]
}
{% endschema %}
