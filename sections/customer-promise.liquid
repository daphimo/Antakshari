{{ 'contact-page.css' | asset_url | stylesheet_tag }}
{% style %}#CustomerPromise-{{ section.id }}{--cp-bg:{{ section.settings.background }};--cp-card:{{ section.settings.card_background }};--cp-text:{{ section.settings.text_color }};--cp-muted:{{ section.settings.muted_color }};--cp-accent:{{ section.settings.accent_color }};--cp-border:{{ section.settings.border_color }};--cp-width:{{ section.settings.container_width }}px;--cp-columns:{{ section.settings.columns }};--cp-gap:{{ section.settings.gap }}px;--cp-radius:{{ section.settings.radius }}px;--cp-pt:{{ section.settings.padding_top }}px;--cp-pb:{{ section.settings.padding_bottom }}px}{% endstyle %}
<section id="CustomerPromise-{{ section.id }}" class="contact-page-section"><div class="contact-page__inner"><header class="contact-page__section-header contact-page__section-header--center"><p class="contact-page__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="contact-page__heading">{{ section.settings.heading | escape }}</h2></header><div class="customer-promise__grid">{% for block in section.blocks %}<article class="customer-promise-card" {{ block.shopify_attributes }}><span class="customer-promise-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24">{% case block.settings.icon %}{% when 'heart' %}<path d="M12 20S4 16 4 9a4 4 0 0 1 8-2 4 4 0 0 1 8 2c0 7-8 11-8 11Z"/>{% when 'lock' %}<rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/>{% when 'sparkle' %}<path d="m12 3 1.5 5.5L19 10l-5.5 1.5L12 17l-1.5-5.5L5 10l5.5-1.5L12 3Z"/>{% else %}<path d="m5 12 4 4L19 6"/>{% endcase %}</svg></span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.description | escape }}</p></article>{% endfor %}</div></div></section>
{% schema %}{"name":"Customer promise","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our promise"},{"type":"text","id":"heading","label":"Heading","default":"Support you can count on"},{"type":"range","id":"columns","label":"Desktop columns","min":2,"max":4,"step":1,"default":4},{"type":"range","id":"gap","label":"Card gap","min":8,"max":40,"step":2,"unit":"px","default":18},{"type":"range","id":"radius","label":"Card radius","min":0,"max":30,"step":2,"unit":"px","default":18},{"type":"range","id":"container_width","label":"Container width","min":900,"max":1800,"step":20,"unit":"px","default":1400},{"type":"color","id":"background","label":"Background","default":"#f7efe5"},{"type":"color","id":"card_background","label":"Card background","default":"#fffaf3"},{"type":"color","id":"text_color","label":"Text","default":"#3d1f15"},{"type":"color","id":"muted_color","label":"Description","default":"#705b52"},{"type":"color","id":"accent_color","label":"Accent","default":"#a65332"},{"type":"color","id":"border_color","label":"Borders","default":"#dfd0c3"},{"type":"range","id":"padding_top","label":"Top padding","min":20,"max":140,"step":4,"unit":"px","default":76},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":20,"max":140,"step":4,"unit":"px","default":76}],"blocks":[{"type":"promise","name":"Promise","settings":[{"type":"select","id":"icon","label":"Icon","options":[{"value":"check","label":"Check"},{"value":"heart","label":"Heart"},{"value":"lock","label":"Lock"},{"value":"sparkle","label":"Sparkle"}],"default":"check"},{"type":"text","id":"title","label":"Title","default":"Fast response"},{"type":"text","id":"description","label":"Description","default":"Helpful answers without the long wait."}]}],"presets":[{"name":"Customer promise","blocks":[{"type":"promise"},{"type":"promise","settings":{"icon":"heart","title":"Friendly support","description":"Real people who care about your experience."}},{"type":"promise","settings":{"icon":"lock","title":"Secure communication","description":"Your personal information stays protected."}},{"type":"promise","settings":{"icon":"sparkle","title":"Trusted service","description":"Thoughtful help from start to finish."}}]}]}{% endschema %}
