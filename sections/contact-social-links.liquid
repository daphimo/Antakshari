{{ 'contact-page.css' | asset_url | stylesheet_tag }}
{% style %}#ContactSocials-{{ section.id }}{--cp-bg:{{ section.settings.background }};--cp-card:{{ section.settings.icon_background }};--cp-text:{{ section.settings.icon_color }};--cp-muted:{{ section.settings.muted_color }};--cp-accent:{{ section.settings.accent_color }};--cp-border:{{ section.settings.border_color }};--cp-width:{{ section.settings.container_width }}px;--cp-pt:{{ section.settings.padding_top }}px;--cp-pb:{{ section.settings.padding_bottom }}px}{% endstyle %}
<section id="ContactSocials-{{ section.id }}" class="contact-page-section contact-socials"><div class="contact-page__inner"><p class="contact-page__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="contact-page__heading">{{ section.settings.heading | escape }}</h2>{% if section.settings.description != blank %}<div class="contact-page__copy rte">{{ section.settings.description }}</div>{% endif %}<div class="contact-socials__list">{% assign networks = 'instagram,facebook,tiktok,youtube,pinterest,linkedin' | split: ',' %}{% for network in networks %}{% assign show_key = 'show_' | append: network %}{% assign link_key = network | append: '_url' %}{% if section.settings[show_key] and section.settings[link_key] != blank %}<a class="contact-socials__link" href="{{ section.settings[link_key] }}" target="_blank" rel="noopener noreferrer" aria-label="{{ network | capitalize }}">{% assign icon_name = network %}<svg viewBox="0 0 20 20" aria-hidden="true">{% render 'icon', icon: icon_name %}</svg></a>{% endif %}{% endfor %}</div></div></section>
{% schema %}{"name":"Contact social links","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Stay connected"},{"type":"text","id":"heading","label":"Heading","default":"Follow our journey"},{"type":"richtext","id":"description","label":"Description","default":"<p>New collections, craft stories and moments worth celebrating.</p>"},{"type":"checkbox","id":"show_instagram","label":"Show Instagram","default":true},{"type":"url","id":"instagram_url","label":"Instagram URL"},{"type":"checkbox","id":"show_facebook","label":"Show Facebook","default":true},{"type":"url","id":"facebook_url","label":"Facebook URL"},{"type":"checkbox","id":"show_tiktok","label":"Show TikTok","default":false},{"type":"url","id":"tiktok_url","label":"TikTok URL"},{"type":"checkbox","id":"show_youtube","label":"Show YouTube","default":false},{"type":"url","id":"youtube_url","label":"YouTube URL"},{"type":"checkbox","id":"show_pinterest","label":"Show Pinterest","default":false},{"type":"url","id":"pinterest_url","label":"Pinterest URL"},{"type":"checkbox","id":"show_linkedin","label":"Show LinkedIn","default":false},{"type":"url","id":"linkedin_url","label":"LinkedIn URL"},{"type":"range","id":"container_width","label":"Container width","min":700,"max":1400,"step":20,"unit":"px","default":1000},{"type":"color","id":"background","label":"Background","default":"#fffdf9"},{"type":"color","id":"icon_background","label":"Icon background","default":"#fffaf3"},{"type":"color","id":"icon_color","label":"Icon color","default":"#3d1f15"},{"type":"color","id":"muted_color","label":"Description","default":"#705b52"},{"type":"color","id":"accent_color","label":"Accent","default":"#a65332"},{"type":"color","id":"border_color","label":"Borders","default":"#e2d6ca"},{"type":"range","id":"padding_top","label":"Top padding","min":20,"max":140,"step":4,"unit":"px","default":68},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":20,"max":140,"step":4,"unit":"px","default":68}],"presets":[{"name":"Contact social links"}]}{% endschema %}
