{{ 'contact-page.css' | asset_url | stylesheet_tag }}
{% style %}#ContactNewsletter-{{ section.id }}{--cp-bg:{{ section.settings.background }};--cp-card:{{ section.settings.card_background }};--cp-input:{{ section.settings.input_background }};--cp-text:{{ section.settings.text_color }};--cp-muted:{{ section.settings.muted_color }};--cp-accent:{{ section.settings.accent_color }};--cp-button-text:{{ section.settings.button_text_color }};--cp-border:{{ section.settings.border_color }};--cp-width:{{ section.settings.container_width }}px;--cp-radius:{{ section.settings.radius }}px;--cp-pt:{{ section.settings.padding_top }}px;--cp-pb:{{ section.settings.padding_bottom }}px}{% endstyle %}
<section id="ContactNewsletter-{{ section.id }}" class="contact-page-section"><div class="contact-page__inner"><div class="contact-newsletter__box"><p class="contact-page__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="contact-page__heading">{{ section.settings.heading | escape }}</h2>{% if section.settings.description != blank %}<div class="contact-page__copy rte">{{ section.settings.description }}</div>{% endif %}{% form 'customer', class: 'contact-newsletter__form' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="ContactNewsletterEmail-{{ section.id }}">Email address</label><input id="ContactNewsletterEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" placeholder="{{ section.settings.placeholder | escape }}" autocomplete="email" required><button class="contact-page__button" type="submit">{{ section.settings.button_label | escape }}</button>{% endform %}{% if form.posted_successfully? %}<p class="contact-newsletter__message" role="status">{{ section.settings.success_message | escape }}</p>{% endif %}{% if form.errors %}<div class="contact-newsletter__message" role="alert">{{ form.errors | default_errors }}</div>{% endif %}</div></div></section>
{% schema %}{"name":"Contact newsletter","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"From our world to yours"},{"type":"text","id":"heading","label":"Heading","default":"Stay inspired"},{"type":"richtext","id":"description","label":"Description","default":"<p>Receive new arrivals, styling ideas and stories from the craftspeople who inspire us.</p>"},{"type":"text","id":"placeholder","label":"Email placeholder","default":"Your email address"},{"type":"text","id":"button_label","label":"Button label","default":"Subscribe"},{"type":"text","id":"success_message","label":"Success message","default":"Thank you for joining us."},{"type":"range","id":"container_width","label":"Container width","min":800,"max":1400,"step":20,"unit":"px","default":1100},{"type":"range","id":"radius","label":"Card radius","min":0,"max":36,"step":2,"unit":"px","default":24},{"type":"color","id":"background","label":"Section background","default":"#f7efe5"},{"type":"color","id":"card_background","label":"Card background","default":"#fffaf3"},{"type":"color","id":"input_background","label":"Field background","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#3d1f15"},{"type":"color","id":"muted_color","label":"Description","default":"#705b52"},{"type":"color","id":"accent_color","label":"Button background","default":"#a65332"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},{"type":"color","id":"border_color","label":"Borders","default":"#dfd0c3"},{"type":"range","id":"padding_top","label":"Top padding","min":20,"max":140,"step":4,"unit":"px","default":76},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":20,"max":140,"step":4,"unit":"px","default":88}],"presets":[{"name":"Contact newsletter"}]}{% endschema %}
