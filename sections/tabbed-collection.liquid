{{ 'tabbed-collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'tabbed-collection.js' | asset_url }}" defer="defer"></script>
{% render 'add-to-cart-button-styles' %}

<section
  id="TabbedCollection-{{ section.id }}"
  class="tabbed-collection"
  style="
    --tc-background: {{ section.settings.background }};
    --tc-card-background: {{ section.settings.card_background }};
    --tc-text: {{ section.settings.text_color }};
    --tc-muted: {{ section.settings.muted_color }};
    --tc-accent: {{ section.settings.accent_color }};
    --tc-border: {{ section.settings.border_color }};
    --tc-card-radius: {{ section.settings.card_radius }}px;
    --tc-image-radius: {{ section.settings.image_radius }}px;
    --tc-columns: {{ section.settings.columns }};
    --tc-gap: {{ section.settings.gap }}px;
    --tc-padding-top: {{ section.settings.padding_top }}px;
    --tc-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="tabbed-collection__inner">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.description != blank %}
      <header class="tabbed-collection__header">
        {% if section.settings.eyebrow != blank %}
          <p class="tabbed-collection__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="tabbed-collection__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
        {% if section.settings.description != blank %}
          <div class="tabbed-collection__description rte">{{ section.settings.description }}</div>
        {% endif %}
      </header>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <tabbed-collection data-section-id="{{ section.id }}">
        <div class="tabbed-collection__tabs" role="tablist" aria-label="{{ section.settings.heading | default: 'Collections' | escape }}">
          {% for block in section.blocks %}
            {% liquid
              assign tab_collection = block.settings.collection
              assign tab_title = block.settings.title_override | default: tab_collection.title | default: 'Collection'
            %}
            <button
              id="Tab-{{ section.id }}-{{ block.id }}"
              class="tabbed-collection__tab{% if forloop.first %} is-active{% endif %}"
              type="button"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="Panel-{{ section.id }}-{{ block.id }}"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              data-tab
              {{ block.shopify_attributes }}
            >
              {{ tab_title | escape }}
            </button>
          {% endfor %}
        </div>

        {% for block in section.blocks %}
          {% assign tab_collection = block.settings.collection %}
          <div
            id="Panel-{{ section.id }}-{{ block.id }}"
            class="tabbed-collection__panel{% if forloop.first %} is-active{% endif %}"
            role="tabpanel"
            aria-labelledby="Tab-{{ section.id }}-{{ block.id }}"
            {% unless forloop.first %}hidden{% endunless %}
            data-panel
          >
            {% if tab_collection != blank and tab_collection.products_count > 0 %}
              <ul class="tabbed-collection__grid" role="list">
                {% for product in tab_collection.products limit: section.settings.products_to_show %}
                  {% liquid
                    assign variant = product.selected_or_first_available_variant
                    assign card_image = variant.featured_image | default: product.featured_image
                    assign can_add = variant.available
                    assign card_button_label = section.settings.button_label
                    unless can_add
                      assign card_button_label = 'products.product.sold_out' | t
                    endunless
                    assign form_id = 'TabbedCollectionForm-' | append: section.id | append: '-' | append: block.id | append: '-' | append: product.id
                  %}
                  <li class="tabbed-product-card">
                    <div class="tabbed-product-card__media">
                      {% if card_image != blank %}
                        {{
                          card_image
                          | image_url: width: 900
                          | image_tag:
                            class: 'tabbed-product-card__image',
                            loading: 'lazy',
                            widths: '240, 360, 480, 640, 800, 900',
                            sizes: '(min-width: 1200px) 22vw, (min-width: 750px) 32vw, 48vw',
                            alt: card_image.alt
                        }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'tabbed-product-card__image tabbed-product-card__placeholder' }}
                      {% endif %}
                      {% if variant.compare_at_price > variant.price %}
                        <span class="tabbed-product-card__sale">Sale</span>
                      {% endif %}
                    </div>

                    <div class="tabbed-product-card__content">
                      <h3 class="tabbed-product-card__title">{{ product.title | escape }}</h3>
                      <div class="tabbed-product-card__price">
                        <span>{{ variant.price | money }}</span>
                        {% if variant.compare_at_price > variant.price %}
                          <s>{{ variant.compare_at_price | money }}</s>
                        {% endif %}
                      </div>

                      <product-form-component
                        data-section-id="{{ section.id }}"
                        data-product-id="{{ product.id }}"
                        on:submit="/handleSubmit"
                        class="tabbed-product-card__form"
                      >
                        <div class="visually-hidden" aria-live="assertive" role="status" aria-atomic="true" ref="liveRegion"></div>
                        {% form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' %}
                          <input
                            type="hidden"
                            name="id"
                            ref="variantId"
                            value="{{ variant.id }}"
                            {% unless can_add %}disabled{% endunless %}
                          >
                          <input type="hidden" name="quantity" value="{{ variant.quantity_rule.min | default: 1 }}">
                          {% render 'add-to-cart-button',
                            add_to_cart_text: card_button_label,
                            class: 'tabbed-product-card__button add-to-cart-button',
                            can_add_to_cart: can_add,
                            product: product
                          %}
                        {% endform %}
                      </product-form-component>
                    </div>
                  </li>
                {% endfor %}
              </ul>
            {% else %}
              <div class="tabbed-collection__empty">Choose a collection with products for this tab.</div>
            {% endif %}
          </div>
        {% endfor %}
      </tabbed-collection>
    {% else %}
      <div class="tabbed-collection__empty">Add collection tabs in the theme editor.</div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "Tabbed collections",
  "tag": "section",
  "class": "section-tabbed-collections",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop the edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your favourites" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Explore a considered selection and add your favourites directly to the bag.</p>" },
    { "type": "range", "id": "products_to_show", "label": "Products per tab", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Desktop columns", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "text", "id": "button_label", "label": "Add button label", "default": "Add to bag" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "gap", "label": "Card gap", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "range", "id": "card_radius", "label": "Card radius", "min": 0, "max": 30, "step": 2, "unit": "px", "default": 18 },
    { "type": "range", "id": "image_radius", "label": "Image radius", "min": 0, "max": 28, "step": 2, "unit": "px", "default": 14 },
    { "type": "color", "id": "background", "label": "Section background", "default": "#fbf7ef" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#3d1f15" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#7a6258" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#a84e2c" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#e4d5c5" },
    { "type": "range", "id": "padding_top", "label": "Top padding", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom", "label": "Bottom padding", "min": 24, "max": 120, "step": 4, "unit": "px", "default": 76 }
  ],
  "blocks": [
    {
      "type": "collection_tab",
      "name": "Collection tab",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title_override", "label": "Collection title override", "info": "Leave blank to use the collection name." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Tabbed collections",
      "blocks": [{ "type": "collection_tab" }, { "type": "collection_tab" }, { "type": "collection_tab" }]
    }
  ]
}
{% endschema %}
