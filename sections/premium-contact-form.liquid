{{ 'contact-page.css' | asset_url | stylesheet_tag }}
{% style %}#contact-form{--cp-bg:{{ section.settings.background }};--cp-card:{{ section.settings.card_background }};--cp-input:{{ section.settings.input_background }};--cp-text:{{ section.settings.text_color }};--cp-muted:{{ section.settings.muted_color }};--cp-accent:{{ section.settings.accent_color }};--cp-button-text:{{ section.settings.button_text_color }};--cp-border:{{ section.settings.border_color }};--cp-width:{{ section.settings.container_width }}px;--cp-radius:{{ section.settings.radius }}px;--cp-pt:{{ section.settings.padding_top }}px;--cp-pb:{{ section.settings.padding_bottom }}px}{% endstyle %}
<section id="contact-form" class="contact-page-section"><div class="contact-page__inner">
  <header class="contact-page__section-header contact-page__section-header--center"><p class="contact-page__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="contact-page__heading">{{ section.settings.heading | escape }}</h2>{% if section.settings.description != blank %}<div class="contact-page__copy rte">{{ section.settings.description }}</div>{% endif %}</header>
  <div class="premium-contact-form">{% form 'contact', id: 'PremiumContactForm' %}
    {% if form.posted_successfully? %}<div class="premium-contact-form__message premium-contact-form__message--success" role="status">{{ section.settings.success_message | escape }}</div>{% endif %}
    {% if form.errors %}<div class="premium-contact-form__message premium-contact-form__message--error" role="alert">{{ form.errors | default_errors }}</div>{% endif %}
    <div class="premium-contact-form__grid">
      <div><label for="ContactFirstName-{{ section.id }}">First name</label><input id="ContactFirstName-{{ section.id }}" name="contact[first_name]" autocomplete="given-name" required></div>
      <div><label for="ContactLastName-{{ section.id }}">Last name</label><input id="ContactLastName-{{ section.id }}" name="contact[last_name]" autocomplete="family-name" required></div>
      <div><label for="ContactEmail-{{ section.id }}">Email</label><input id="ContactEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email }}" autocomplete="email" required></div>
      <div><label for="ContactPhone-{{ section.id }}">Phone</label><input id="ContactPhone-{{ section.id }}" type="tel" name="contact[phone]" autocomplete="tel"></div>
      <div><label for="ContactSubject-{{ section.id }}">Subject</label><select id="ContactSubject-{{ section.id }}" name="contact[subject]"><option>General Inquiry</option><option>Order Support</option><option>Product Question</option><option>Returns &amp; Refunds</option><option>Wholesale</option><option>Partnership</option></select></div>
      <div><label for="ContactOrder-{{ section.id }}">Order number</label><input id="ContactOrder-{{ section.id }}" name="contact[order_number]" placeholder="Optional"></div>
      <div class="premium-contact-form__field--full"><label for="ContactMessage-{{ section.id }}">Message</label><textarea id="ContactMessage-{{ section.id }}" name="contact[body]" required>{{ form.body }}</textarea></div>
    </div><div class="premium-contact-form__actions"><button class="contact-page__button" type="submit">{{ section.settings.button_label | escape }}</button></div>
  {% endform %}</div>
</div></section>
{% schema %}{"name":"Premium contact form","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Send a message"},{"type":"text","id":"heading","label":"Heading","default":"How can we help?"},{"type":"richtext","id":"description","label":"Description","default":"<p>Share a few details and our support team will get back to you as soon as possible.</p>"},{"type":"text","id":"button_label","label":"Submit label","default":"Send message"},{"type":"text","id":"success_message","label":"Success message","default":"Thank you. Your message has been sent successfully."},{"type":"range","id":"container_width","label":"Container width","min":800,"max":1400,"step":20,"unit":"px","default":1100},{"type":"range","id":"radius","label":"Form radius","min":0,"max":32,"step":2,"unit":"px","default":20},{"type":"color","id":"background","label":"Section background","default":"#f7efe5"},{"type":"color","id":"card_background","label":"Form background","default":"#fffaf3"},{"type":"color","id":"input_background","label":"Field background","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#3d1f15"},{"type":"color","id":"muted_color","label":"Description","default":"#705b52"},{"type":"color","id":"accent_color","label":"Button background","default":"#a65332"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},{"type":"color","id":"border_color","label":"Borders","default":"#dfd0c3"},{"type":"range","id":"padding_top","label":"Top padding","min":20,"max":140,"step":4,"unit":"px","default":84},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":20,"max":140,"step":4,"unit":"px","default":84}],"presets":[{"name":"Premium contact form"}]}{% endschema %}
