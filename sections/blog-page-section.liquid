      "min": 10,
      "max": 24,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "excerpt_mobile_size",
      "label": "Excerpt mobile size",
      "min": 10,
      "max": 22,
      "step": 1,
      "default": 14,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "excerpt_line_height",
      "label": "Excerpt line height",
      "min": 100,
      "max": 220,
      "step": 5,
      "default": 160,
      "unit": "%"
    },
    { "type": "color", "id": "excerpt_color", "label": "Excerpt color", "default": "#6F5E54" },
    {
      "type": "range",
      "id": "meta_size",
      "label": "Meta size",
      "min": 8,
      "max": 20,
      "step": 1,
      "default": 11,
      "unit": "px"
    },
