      "min": 0,
      "max": 10,
      "step": 1,
      "default": 2,
      "unit": "px"
    },
    { "type": "color", "id": "meta_color", "label": "Meta color", "default": "#9A5834" },
    { "type": "text", "id": "cards__readmore", "label": "Read More", "default": "Read More" },
    { "type": "color", "id": "read", "label": "Read color", "default": "#E8A53A" },
    { "type": "header", "content": "Hover" },
    {
      "type": "range",
      "id": "hover_lift",
      "label": "Card lift",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 6,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "hover_shadow_opacity",
      "label": "Shadow opacity",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 12,
      "unit": "%"
    }
  ],
  "presets": [{ "name": "Blog page Section" }],
  "enabled_on": { "templates": ["blog"] }
}
{% endschema %}
