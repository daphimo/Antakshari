{{ 'contact-page.css' | asset_url | stylesheet_tag }}
{% style %}#FaqPreview-{{ section.id }}{--cp-bg:{{ section.settings.background }};--cp-card:{{ section.settings.card_background }};--cp-text:{{ section.settings.text_color }};--cp-muted:{{ section.settings.muted_color }};--cp-accent:{{ section.settings.accent_color }};--cp-button-text:{{ section.settings.button_text_color }};--cp-border:{{ section.settings.border_color }};--cp-width:{{ section.settings.container_width }}px;--cp-radius:{{ section.settings.radius }}px;--cp-pt:{{ section.settings.padding_top }}px;--cp-pb:{{ section.settings.padding_bottom }}px}{% endstyle %}
<section id="FaqPreview-{{ section.id }}" class="contact-page-section"><div class="contact-page__inner"><header class="contact-page__section-header contact-page__section-header--center"><p class="contact-page__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="contact-page__heading">{{ section.settings.heading | escape }}</h2></header><div class="faq-preview__list">{% for block in section.blocks %}<details class="faq-preview__item" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}><summary>{{ block.settings.question | escape }}</summary><div class="faq-preview__answer rte">{{ block.settings.answer }}</div></details>{% endfor %}</div>{% if section.settings.button_label != blank %}<div class="faq-preview__footer"><a class="contact-page__button" {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ section.settings.button_label | escape }}</a></div>{% endif %}</div></section>
{% schema %}{"name":"FAQ preview","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Quick answers"},{"type":"text","id":"heading","label":"Heading","default":"Frequently asked questions"},{"type":"text","id":"button_label","label":"Button label","default":"View all FAQs"},{"type":"url","id":"button_link","label":"Button link"},{"type":"range","id":"container_width","label":"Container width","min":700,"max":1300,"step":20,"unit":"px","default":1000},{"type":"range","id":"radius","label":"Item radius","min":0,"max":28,"step":2,"unit":"px","default":14},{"type":"color","id":"background","label":"Background","default":"#f7efe5"},{"type":"color","id":"card_background","label":"Item background","default":"#fffaf3"},{"type":"color","id":"text_color","label":"Questions","default":"#3d1f15"},{"type":"color","id":"muted_color","label":"Answers","default":"#705b52"},{"type":"color","id":"accent_color","label":"Accent","default":"#a65332"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},{"type":"color","id":"border_color","label":"Borders","default":"#dfd0c3"},{"type":"range","id":"padding_top","label":"Top padding","min":20,"max":140,"step":4,"unit":"px","default":76},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":20,"max":140,"step":4,"unit":"px","default":76}],"blocks":[{"type":"faq","name":"FAQ","settings":[{"type":"text","id":"question","label":"Question","default":"How quickly will I receive a response?"},{"type":"richtext","id":"answer","label":"Answer","default":"<p>We usually respond within one business day during our published support hours.</p>"},{"type":"checkbox","id":"open","label":"Open by default","default":false}]}],"presets":[{"name":"FAQ preview","blocks":[{"type":"faq"},{"type":"faq","settings":{"question":"Can you help with an existing order?","answer":"<p>Yes. Include your order number in the contact form so our team can help quickly.</p>"}},{"type":"faq","settings":{"question":"Do you support returns and exchanges?","answer":"<p>Select Returns & Refunds in the form and tell us what you need help with.</p>"}}]}]}{% endschema %}
