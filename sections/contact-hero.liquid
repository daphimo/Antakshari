{{ 'contact-page.css' | asset_url | stylesheet_tag }}
{% style %}#ContactHero-{{ section.id }}{--cp-bg:{{ section.settings.background }};--cp-text:{{ section.settings.text_color }};--cp-muted:{{ section.settings.description_color }};--cp-accent:{{ section.settings.accent_color }};--cp-button-text:{{ section.settings.button_text_color }};--cp-overlay:{{ section.settings.overlay_color }};--cp-overlay-opacity:{{ section.settings.overlay_opacity | divided_by: 100.0 }};--cp-hero-height:{{ section.settings.height }}px;--cp-heading:{{ section.settings.heading_size }}px}{% endstyle %}
<section id="ContactHero-{{ section.id }}" class="contact-page-section contact-hero">
  {% if section.settings.image != blank %}{{ section.settings.image | image_url: width: 2200 | image_tag: class: 'contact-hero__image', loading: 'eager', widths: '750,1000,1400,1800,2200', sizes: '100vw' }}<span class="contact-hero__veil" aria-hidden="true"></span>{% endif %}
  <div class="contact-page__inner contact-hero__inner"><div class="contact-hero__content">
    {% if section.settings.eyebrow != blank %}<p class="contact-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>{% endif %}
    <h1 class="contact-page__heading">{{ section.settings.heading | escape }}</h1>
    {% if section.settings.description != blank %}<div class="contact-page__copy rte">{{ section.settings.description }}</div>{% endif %}
    {% if section.settings.button_label != blank %}<a class="contact-page__button contact-hero__button" {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}>{{ section.settings.button_label | escape }}</a>{% endif %}
  </div></div>
</section>
{% schema %}{"name":"Contact hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"We are here to help"},{"type":"text","id":"heading","label":"Heading","default":"Let’s start a conversation"},{"type":"richtext","id":"description","label":"Description","default":"<p>Questions about an order, a product or simply want to say hello? Our team would love to hear from you.</p>"},{"type":"image_picker","id":"image","label":"Background image"},{"type":"text","id":"button_label","label":"Button label","default":"Send us a message"},{"type":"url","id":"button_link","label":"Button link"},{"type":"range","id":"height","label":"Section height","min":360,"max":760,"step":20,"unit":"px","default":520},{"type":"range","id":"heading_size","label":"Heading size","min":36,"max":84,"step":2,"unit":"px","default":64},{"type":"color","id":"background","label":"Background","default":"#f7efe5"},{"type":"color","id":"text_color","label":"Heading text","default":"#3d1f15"},{"type":"color","id":"description_color","label":"Description text","default":"#70564b"},{"type":"color","id":"accent_color","label":"Button background","default":"#a65332"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},{"type":"color","id":"overlay_color","label":"Image overlay","default":"#1d0e08"},{"type":"range","id":"overlay_opacity","label":"Overlay opacity","min":0,"max":80,"step":5,"unit":"%","default":25}],"presets":[{"name":"Contact hero"}]}{% endschema %}
