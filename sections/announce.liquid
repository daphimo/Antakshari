{{ 'splide-announcement-bar.css' | asset_url | stylesheet_tag }}

<section
  id="SplideAnnouncementBar-{{ section.id }}"
  class="splide-announcement-bar"
  style="
    --announcement-background: {{ section.settings.background_color }};
    --announcement-text-color: {{ section.settings.text_color }};
    --announcement-link-color: {{ section.settings.link_color }};
    --announcement-font-size: {{ section.settings.font_size }}px;
    --announcement-mobile-font-size: {{ section.settings.mobile_font_size }}px;
    --announcement-font-weight: {{ section.settings.font_weight }};
    --announcement-letter-spacing: {{ section.settings.letter_spacing }}px;
    --announcement-min-height: {{ section.settings.min_height }}px;
    --announcement-mobile-min-height: {{ section.settings.mobile_min_height }}px;
    --announcement-padding-inline: {{ section.settings.padding_inline }}px;
    --announcement-icon-size: {{ section.settings.icon_size }}px;
    --announcement-content-gap: {{ section.settings.content_gap }}px;
    --announcement-arrow-size: {{ section.settings.arrow_size }}px;
    --announcement-arrow-color: {{ section.settings.arrow_color }};
    --announcement-border-color: {{ section.settings.border_color }};
    --announcement-border-width: {{ section.settings.border_width }}px;
  "
>
  <div class="splide-announcement-bar__inner">
    <div
      id="splide-{{ section.id }}"
      class="splide splide-announcement-bar__slider{% if section.blocks.size <= 1 %} splide-announcement-bar__slider--single{% endif %}"
      role="region"
      aria-label="{{ section.settings.accessibility_label | escape }}"
    >
      <div class="splide__track">
        <ul class="splide__list">
          {% for block in section.blocks %}
            <li
              class="splide__slide splide-announcement-bar__slide"
              data-block-id="{{ block.id }}"
              data-slide-index="{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.link != blank %}
                <a
                  href="{{ block.settings.link }}"
                  class="splide-announcement-bar__item"
                  {% if block.settings.open_new_tab %}
                    target="_blank"
                    rel="noopener noreferrer"
                  {% endif %}
                >
              {% else %}
                <div class="splide-announcement-bar__item">
              {% endif %}

                {% if block.settings.icon != blank %}
                  <span class="splide-announcement-bar__icon">
                    {{
                      block.settings.icon
                      | image_url: width: 100
                      | image_tag:
                        loading: 'lazy',
                        widths: '30, 50, 70, 100',
                        class: 'splide-announcement-bar__icon-image'
                    }}
                  </span>
                {% elsif block.settings.custom_icon != blank %}
                  <span class="splide-announcement-bar__icon splide-announcement-bar__custom-icon">
                    {{ block.settings.custom_icon }}
                  </span>
                {% endif %}

                {% if block.settings.text != blank %}
                  <span class="splide-announcement-bar__text">
                    {{ block.settings.text }}
                  </span>
                {% endif %}

                {% if block.settings.link_label != blank %}
                  <span class="splide-announcement-bar__link-label">
                    {{ block.settings.link_label }}
                  </span>
                {% endif %}

              {% if block.settings.link != blank %}
                </a>
              {% else %}
                </div>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </div>

      {% if section.settings.show_arrows and section.blocks.size > 1 %}
        <div class="splide__arrows splide-announcement-bar__arrows">
          <button
            class="splide__arrow splide__arrow--prev"
            type="button"
            aria-label="Previous announcement"
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M15 18 9 12l6-6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>

          <button
            class="splide__arrow splide__arrow--next"
            type="button"
            aria-label="Next announcement"
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="m9 18 6-6-6-6"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </div>
      {% endif %}

      {% if section.settings.show_pagination and section.blocks.size > 1 %}
        <ul class="splide__pagination"></ul>
      {% endif %}
    </div>
  </div>
</section>

{% render 'splide-slider',
  slider_id: section.id,
  section_id: section.id
%}

{% schema %}
{
  "name": "Splide announcement bar",
  "tag": "section",
  "class": "section-splide-announcement-bar",
  "settings": [
    {
      "type": "header",
      "content": "Announcement bar"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Store announcements"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#231810"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "link_color",
      "label": "Link label color",
      "default": "#f5d6a5"
    },
    {
      "type": "range",
      "id": "min_height",
      "label": "Desktop minimum height",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "mobile_min_height",
      "label": "Mobile minimum height",
      "min": 30,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "padding_inline",
      "label": "Horizontal padding",
      "min": 10,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 40
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Desktop text size",
      "min": 10,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile text size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Regular"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ],
      "default": "500"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": 0,
      "max": 6,
      "step": 0.1,
      "unit": "px",
      "default": 0.4
    },
    {
      "type": "header",
      "content": "Icons and spacing"
    },
    {
      "type": "range",
      "id": "icon_size",
      "label": "Icon size",
      "min": 10,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "content_gap",
      "label": "Content gap",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "Border"
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Bottom border width",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Splide settings"
    },
    {
      "type": "select",
      "id": "slider_type",
      "label": "Slider type",
      "options": [
        {
          "value": "slide",
          "label": "Slide"
        },
        {
          "value": "loop",
          "label": "Loop"
        },
        {
          "value": "fade",
          "label": "Fade"
        }
      ],
      "default": "loop"
    },
    {
      "type": "range",
      "id": "perPageDesktop",
      "label": "Announcements per view on desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "perPageMobile",
      "label": "Announcements per view on mobile",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "perMove",
      "label": "Announcements to move",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Desktop announcement gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile announcement gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Enable autoplay",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay speed",
      "min": 1,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "range",
      "id": "transition_speed",
      "label": "Transition speed",
      "min": 300,
      "max": 2000,
      "step": 100,
      "unit": "ms",
      "default": 700
    },
    {
      "type": "checkbox",
      "id": "show_arrows",
      "label": "Show navigation arrows",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show pagination dots",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause autoplay on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "pause_on_focus",
      "label": "Pause autoplay on focus",
      "default": true
    },
    {
      "type": "header",
      "content": "Arrow style"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Arrow color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "arrow_size",
      "label": "Arrow size",
      "min": 20,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon image"
        },
        {
          "type": "html",
          "id": "custom_icon",
          "label": "Custom SVG or icon HTML",
          "info": "Used only when no icon image is selected."
        },
        {
          "type": "inline_richtext",
          "id": "text",
          "label": "Announcement text",
          "default": "Complimentary shipping on qualifying orders"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Announcement link"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open link in a new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Splide announcement bar",
      "category": "Custom",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Complimentary shipping on qualifying orders",
            "link_label": "Shop now"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Festive collection is now available",
            "link_label": "Explore collection"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "Easy returns and secure checkout",
            "link_label": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}