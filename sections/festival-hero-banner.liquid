{% liquid
  assign desktop_image = section.settings.desktop_image | default: section.settings.mobile_image
  assign mobile_image = section.settings.mobile_image | default: desktop_image
  assign image_alt = section.settings.alt_text | default: desktop_image.alt
  if image_alt == blank and section.settings.link != blank
    assign image_alt = page.title | default: shop.name
  endif
  assign image_loading = 'lazy'
  assign image_priority = 'auto'
  if section.index == 1
    assign image_loading = 'eager'
    assign image_priority = 'high'
  endif
%}
<div class="festival-hero-banner">
  {% if desktop_image != blank %}
    {% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{% endif %}
      <picture>
        {% if mobile_image != blank %}
          <source media="(max-width: 749px)" width="{{ mobile_image.width }}" height="{{ mobile_image.height }}" srcset="{{ mobile_image | image_url: width: 375 }} 375w, {{ mobile_image | image_url: width: 550 }} 550w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w" sizes="100vw">
        {% endif %}
        {{ desktop_image | image_url: width: 3200 | image_tag: widths: '750, 1100, 1500, 2000, 2400, 3200', sizes: '100vw', alt: image_alt, loading: image_loading, fetchpriority: image_priority }}
      </picture>
    {% if section.settings.link != blank %}</a>{% endif %}
  {% elsif request.design_mode %}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'festival-hero-banner__placeholder' }}
  {% endif %}
</div>
{% stylesheet %}
  .festival-hero-banner { width: 100%; background: #F7F1E3; }
  .festival-hero-banner a, .festival-hero-banner picture { display: block; }
  .festival-hero-banner img, .festival-hero-banner__placeholder { display: block; width: 100%; height: auto; }
  .festival-hero-banner a:focus-visible { outline: 3px solid #6B1F2A; outline-offset: -3px; }
{% endstylesheet %}

{% schema %}
{
  "name": "Festival hero banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "SEO / accessible image text"
    }
  ],
  "presets": [
    {
      "name": "Festival hero banner",
      "category": "Promotional"
    }
  ]
}
{% endschema %}
