{{ 'contact-page.css' | asset_url | stylesheet_tag }}
{% style %}#ContactMap-{{ section.id }}{--cp-bg:{{ section.settings.background }};--cp-card:{{ section.settings.card_background }};--cp-text:{{ section.settings.text_color }};--cp-muted:{{ section.settings.muted_color }};--cp-accent:{{ section.settings.accent_color }};--cp-border:{{ section.settings.border_color }};--cp-width:{{ section.settings.container_width }}px;--cp-radius:{{ section.settings.radius }}px;--cp-gap:{{ section.settings.gap }}px;--cp-map-height:{{ section.settings.map_height }}px;--cp-pt:{{ section.settings.padding_top }}px;--cp-pb:{{ section.settings.padding_bottom }}px}{% endstyle %}
<section id="ContactMap-{{ section.id }}" class="contact-page-section"><div class="contact-page__inner"><div class="contact-map__layout"><div class="contact-map__info"><p class="contact-page__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="contact-page__heading">{{ section.settings.heading | escape }}</h2><div class="contact-map__address rte">{{ section.settings.address }}</div></div>{% if section.settings.map_url != blank %}<div class="contact-map__frame"><iframe src="{{ section.settings.map_url }}" title="{{ section.settings.map_title | escape }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div>{% endif %}</div></div></section>
{% schema %}{"name":"Contact map","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Visit us"},{"type":"text","id":"heading","label":"Heading","default":"Our store"},{"type":"richtext","id":"address","label":"Address","default":"<p>123 Heritage Lane<br>Jaipur, Rajasthan 302001<br>India</p>"},{"type":"url","id":"map_url","label":"Google Maps embed URL","info":"Paste the URL from the map iframe src attribute. The map is hidden when blank."},{"type":"text","id":"map_title","label":"Map accessibility title","default":"Store location map"},{"type":"range","id":"map_height","label":"Map height","min":280,"max":700,"step":20,"unit":"px","default":440},{"type":"range","id":"container_width","label":"Container width","min":900,"max":1800,"step":20,"unit":"px","default":1400},{"type":"range","id":"gap","label":"Column gap","min":10,"max":60,"step":2,"unit":"px","default":24},{"type":"range","id":"radius","label":"Card radius","min":0,"max":30,"step":2,"unit":"px","default":18},{"type":"color","id":"background","label":"Background","default":"#fffdf9"},{"type":"color","id":"card_background","label":"Address background","default":"#fffaf3"},{"type":"color","id":"text_color","label":"Heading","default":"#3d1f15"},{"type":"color","id":"muted_color","label":"Address","default":"#705b52"},{"type":"color","id":"accent_color","label":"Accent","default":"#a65332"},{"type":"color","id":"border_color","label":"Borders","default":"#e2d6ca"},{"type":"range","id":"padding_top","label":"Top padding","min":20,"max":140,"step":4,"unit":"px","default":76},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":20,"max":140,"step":4,"unit":"px","default":76}],"presets":[{"name":"Contact map"}]}{% endschema %}
