{{ 'contact-page.css' | asset_url | stylesheet_tag }}
{% style %}#BusinessHours-{{ section.id }}{--cp-bg:{{ section.settings.background }};--cp-card:{{ section.settings.card_background }};--cp-text:{{ section.settings.text_color }};--cp-muted:{{ section.settings.muted_color }};--cp-accent:{{ section.settings.accent_color }};--cp-border:{{ section.settings.border_color }};--cp-width:{{ section.settings.container_width }}px;--cp-radius:{{ section.settings.radius }}px;--cp-pt:{{ section.settings.padding_top }}px;--cp-pb:{{ section.settings.padding_bottom }}px}{% endstyle %}
<section id="BusinessHours-{{ section.id }}" class="contact-page-section"><div class="contact-page__inner"><header class="contact-page__section-header contact-page__section-header--center"><p class="contact-page__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="contact-page__heading">{{ section.settings.heading | escape }}</h2>{% if section.settings.description != blank %}<div class="contact-page__copy rte">{{ section.settings.description }}</div>{% endif %}</header><div class="business-hours__card" role="table" aria-label="Business hours">{% assign days = 'Monday,Tuesday,Wednesday,Thursday,Friday,Saturday,Sunday' | split: ',' %}{% for day in days %}{% assign key = day | downcase %}<div class="business-hours__row" role="row"><span class="business-hours__day" role="cell">{{ day }}</span><span class="business-hours__time" role="cell">{{ section.settings[key] | escape }}</span></div>{% endfor %}</div></div></section>
{% schema %}{"name":"Business hours","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Availability"},{"type":"text","id":"heading","label":"Heading","default":"Business hours"},{"type":"richtext","id":"description","label":"Description","default":"<p>Times are shown in our local timezone. Messages received after hours are answered the next working day.</p>"},{"type":"text","id":"monday","label":"Monday","default":"10:00 AM – 6:00 PM"},{"type":"text","id":"tuesday","label":"Tuesday","default":"10:00 AM – 6:00 PM"},{"type":"text","id":"wednesday","label":"Wednesday","default":"10:00 AM – 6:00 PM"},{"type":"text","id":"thursday","label":"Thursday","default":"10:00 AM – 6:00 PM"},{"type":"text","id":"friday","label":"Friday","default":"10:00 AM – 6:00 PM"},{"type":"text","id":"saturday","label":"Saturday","default":"10:00 AM – 4:00 PM"},{"type":"text","id":"sunday","label":"Sunday","default":"Closed"},{"type":"range","id":"container_width","label":"Container width","min":700,"max":1300,"step":20,"unit":"px","default":1000},{"type":"range","id":"radius","label":"Card radius","min":0,"max":30,"step":2,"unit":"px","default":18},{"type":"color","id":"background","label":"Background","default":"#fffdf9"},{"type":"color","id":"card_background","label":"Card background","default":"#fffaf3"},{"type":"color","id":"text_color","label":"Day text","default":"#3d1f15"},{"type":"color","id":"muted_color","label":"Hours text","default":"#705b52"},{"type":"color","id":"accent_color","label":"Accent","default":"#a65332"},{"type":"color","id":"border_color","label":"Borders","default":"#e2d6ca"},{"type":"range","id":"padding_top","label":"Top padding","min":20,"max":140,"step":4,"unit":"px","default":72},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":20,"max":140,"step":4,"unit":"px","default":72}],"presets":[{"name":"Business hours"}]}{% endschema %}
