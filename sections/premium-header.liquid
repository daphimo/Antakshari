{{ 'premium-header.css' | asset_url | stylesheet_tag }}
<script src="{{ 'premium-header.js' | asset_url }}" defer="defer"></script>

{% liquid
  assign header_menu = section.settings.menu
  assign logo_width_2x = section.settings.logo_width | times: 2
  assign logo_alt = section.settings.logo.alt | default: shop.name
%}

<style>
  /* Critical closed state prevents the drawer flashing on screen before the asset CSS loads. */
  #PremiumHeaderDrawer-{{ section.id }}[aria-hidden='true'] {
    transform: translate3d(-110%, 0, 0);
    pointer-events: none;
  }
</style>

<header
  id="PremiumHeader-{{ section.id }}"
  class="premium-header{% if section.settings.enable_sticky %} premium-header--sticky{% endif %}{% if section.settings.enable_transparent %} premium-header--transparent{% endif %}"
  data-premium-header
  data-section-id="{{ section.id }}"
  data-open-on-hover="{{ section.settings.open_on_hover }}"
  style="
    --ph-bg: {{ section.settings.background_color }};
    --ph-text: {{ section.settings.text_color }};
    --ph-accent: {{ section.settings.accent_color }};
    --ph-border: {{ section.settings.border_color }};
    --ph-dropdown-bg: {{ section.settings.dropdown_background }};
    --ph-dropdown-text: {{ section.settings.dropdown_text_color }};
    --ph-logo-width: {{ section.settings.logo_width }}px;
    --ph-page-width: {{ section.settings.page_width }}px;
  "
>
  <div class="premium-header__overlay" data-header-overlay aria-hidden="true"></div>

  <div class="premium-header__masthead">
    <div class="premium-header__top-row">
      <div class="premium-header__mobile-toggle-wrap">
        <button
          type="button"
          class="premium-header__icon-button premium-header__menu-toggle"
          aria-label="Open Menu"
          aria-controls="PremiumHeaderDrawer-{{ section.id }}"
          aria-expanded="false"
          data-drawer-open
        >
          <span class="premium-header__hamburger" aria-hidden="true">
            <span></span><span></span><span></span>
          </span>
        </button>
      </div>

      <div class="premium-header__brand">
        <a class="premium-header__logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
          {% if section.settings.logo != blank %}
            {{
              section.settings.logo
              | image_url: width: logo_width_2x
              | image_tag:
                widths: '120, 180, 240, 320, 400, 500, 560',
                width: section.settings.logo_width,
                loading: 'eager',
                class: 'premium-header__logo-image',
                alt: logo_alt
            }}
          {% else %}
            <span class="premium-header__shop-name">{{ shop.name }}</span>
          {% endif %}
        </a>
      </div>

      <div class="premium-header__actions">
        {% render 'search', style: 'modal', display_style: 'icon' %}
        {% render 'header-actions',
          customer_account_menu: section.settings.customer_account_menu,
          display_style: 'icon',
          section: section
        %}
      </div>
    </div>
  </div>

  <div class="premium-header__navigation-row">
    <nav class="premium-header__nav" aria-label="Primary navigation">
      {% if header_menu != blank %}
        <ul class="premium-header__menu" role="list">
          {% for link in header_menu.links %}
            {% liquid
              assign link_handle = link.title | handleize
              assign promotion_mega_block = blank
              assign collection_mega_block = blank

              for block in section.blocks
                assign block_menu_handle = block.settings.menu_item | handleize
                if block_menu_handle == link_handle
                  if block.type == 'promotion_mega_menu' and promotion_mega_block == blank
                    assign promotion_mega_block = block
                  elsif block.type == 'collection_mega_menu' and collection_mega_block == blank
                    assign collection_mega_block = block
                  endif
                endif
              endfor

              assign has_custom_mega = false
              if promotion_mega_block != blank or collection_mega_block != blank
                assign has_custom_mega = true
              endif

              assign has_panel = false
              if has_custom_mega or link.links != blank
                assign has_panel = true
              endif

              assign panel_id = 'PremiumHeaderPanel-' | append: section.id | append: '-' | append: forloop.index
            %}

            <li
              class="premium-header__menu-item{% if has_custom_mega %} premium-header__menu-item--mega{% endif %}{% if link.current or link.child_active %} is-active{% endif %}"
              data-nav-item
              data-menu-handle="{{ link_handle }}"
            >
              <a
                href="{{ link.url }}"
                class="premium-header__menu-link"
                {% if link.current %}aria-current="page"{% endif %}
                {% if has_panel %}
                  aria-haspopup="true"
                  aria-expanded="false"
                  aria-controls="{{ panel_id }}"
                  data-nav-trigger
                {% endif %}
              >
                <span>{{ link.title }}</span>
                {% if has_panel %}
                  <svg class="premium-header__chevron" viewBox="0 0 10 6" aria-hidden="true"><path d="m1 1 4 4 4-4"></path></svg>
                {% endif %}
              </a>

              {% if promotion_mega_block != blank %}
                {% render 'premium-mega-menu-promotions',
                  block: promotion_mega_block,
                  menu_link: link,
                  section: section,
                  panel_id: panel_id,
                  drawer: false
                %}
              {% elsif collection_mega_block != blank %}
                {% render 'premium-mega-menu-collections',
                  block: collection_mega_block,
                  menu_link: link,
                  section: section,
                  panel_id: panel_id,
                  drawer: false
                %}
              {% elsif link.links != blank %}
                {% render 'premium-header-dropdown',
                  menu_link: link,
                  panel_id: panel_id
                %}
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </nav>
  </div>

  {% render 'premium-header-drawer', section: section, menu: header_menu %}
</header>

{% schema %}
{
  "name": "Premium header",
  "tag": "section",
  "class": "section-premium-header",
  "limit": 1,
  "settings": [
    {
      "type": "header",
      "content": "Logo and navigation"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 70,
      "max": 280,
      "step": 5,
      "unit": "px",
      "label": "Logo width",
      "default": 150
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu"
    },
    {
      "type": "checkbox",
      "id": "open_on_hover",
      "label": "Open desktop menus on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Customer account"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "Customer account menu",
      "default": "customer-account-main-menu"
    },
    {
      "type": "header",
      "content": "Header behavior"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky",
      "label": "Enable sticky header",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_transparent",
      "label": "Transparent over first section",
      "info": "The header becomes solid after scrolling or opening a menu.",
      "default": false
    },
    {
      "type": "range",
      "id": "page_width",
      "min": 1000,
      "max": 1800,
      "step": 20,
      "unit": "px",
      "label": "Content width",
      "default": 1440
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Header background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Header text",
      "default": "#171717"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#7a5c3e"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#e8e5e1"
    },
    {
      "type": "color",
      "id": "dropdown_background",
      "label": "Menu and drawer background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "dropdown_text_color",
      "label": "Menu and drawer text",
      "default": "#171717"
    },
    {
      "type": "header",
      "content": "Drawer promotion"
    },
    {
      "type": "checkbox",
      "id": "show_drawer_promotion",
      "label": "Show collapsible drawer promotion",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "drawer_promotion_image",
      "label": "Promotion image"
    },
    {
      "type": "text",
      "id": "drawer_promotion_caption",
      "label": "Caption",
      "default": "Featured"
    },
    {
      "type": "text",
      "id": "drawer_promotion_title",
      "label": "Title",
      "default": "Discover the latest collection"
    },
    {
      "type": "url",
      "id": "drawer_promotion_link",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "drawer_promotion_open",
      "label": "Open promotion by default",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "promotion_mega_menu",
      "name": "Mega menu — promotions",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Menu item",
          "info": "Enter an exact top-level menu title. Shopify handleizes both values, so Shop All matches shop-all. Only this item becomes a mega menu."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Menu caption",
          "default": "Explore"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Menu heading",
          "default": "Shop the collection"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Menu description"
        },
        {
          "type": "image_picker",
          "id": "promotion_1_image",
          "label": "Promotion 1 image"
        },
        {
          "type": "text",
          "id": "promotion_1_title",
          "label": "Promotion 1 badge",
          "default": "New arrivals"
        },
        {
          "type": "url",
          "id": "promotion_1_link",
          "label": "Promotion 1 link"
        },
        {
          "type": "image_picker",
          "id": "promotion_2_image",
          "label": "Promotion 2 image"
        },
        {
          "type": "text",
          "id": "promotion_2_title",
          "label": "Promotion 2 badge",
          "default": "Bestsellers"
        },
        {
          "type": "url",
          "id": "promotion_2_link",
          "label": "Promotion 2 link"
        },
        {
          "type": "image_picker",
          "id": "promotion_3_image",
          "label": "Promotion 3 image"
        },
        {
          "type": "text",
          "id": "promotion_3_title",
          "label": "Promotion 3 badge",
          "default": "Limited edition"
        },
        {
          "type": "url",
          "id": "promotion_3_link",
          "label": "Promotion 3 link"
        }
      ]
    },
    {
      "type": "collection_mega_menu",
      "name": "Mega menu — collections",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "menu_item",
          "label": "Menu item",
          "info": "Enter an exact top-level menu title. Only the matching item becomes a collection mega menu."
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Caption",
          "default": "Curated edits"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop by collection"
        },
        {
          "type": "collection_list",
          "id": "collections",
          "label": "Collections",
          "limit": 10
        },
        {
          "type": "select",
          "id": "image_ratio",
          "label": "Image ratio",
          "options": [
            { "value": "square", "label": "Square" },
            { "value": "portrait", "label": "Portrait" },
            { "value": "landscape", "label": "Landscape" }
          ],
          "default": "portrait"
        },
        {
          "type": "checkbox",
          "id": "show_view_all",
          "label": "Show view all link",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium header"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
