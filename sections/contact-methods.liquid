{{ 'contact-page.css' | asset_url | stylesheet_tag }}
{% style %}#ContactMethods-{{ section.id }}{--cp-bg:{{ section.settings.background }};--cp-card:{{ section.settings.card_background }};--cp-text:{{ section.settings.text_color }};--cp-muted:{{ section.settings.muted_color }};--cp-accent:{{ section.settings.accent_color }};--cp-border:{{ section.settings.border_color }};--cp-width:{{ section.settings.container_width }}px;--cp-columns:{{ section.settings.columns }};--cp-gap:{{ section.settings.gap }}px;--cp-radius:{{ section.settings.radius }}px;--cp-pt:{{ section.settings.padding_top }}px;--cp-pb:{{ section.settings.padding_bottom }}px}{% endstyle %}
<section id="ContactMethods-{{ section.id }}" class="contact-page-section"><div class="contact-page__inner">
  <header class="contact-page__section-header contact-page__section-header--{{ section.settings.alignment }}"><p class="contact-page__eyebrow">{{ section.settings.eyebrow | escape }}</p><h2 class="contact-page__heading">{{ section.settings.heading | escape }}</h2>{% if section.settings.description != blank %}<div class="contact-page__copy rte">{{ section.settings.description }}</div>{% endif %}</header>
  <div class="contact-methods__grid">{% for block in section.blocks %}<article class="contact-method-card" {{ block.shopify_attributes }}><span class="contact-method-card__icon" aria-hidden="true"><svg viewBox="0 0 24 24">{% case block.settings.icon %}{% when 'email' %}<path d="M3 6h18v12H3zM3 7l9 7 9-7"/>{% when 'phone' %}<path d="M7 3 4 5c0 8 7 15 15 15l2-3-5-3-2 2c-3-1-5-3-6-6l2-2-3-5Z"/>{% when 'whatsapp' %}<path d="M20 11a8 8 0 0 1-12 7l-4 1 1-4a8 8 0 1 1 15-4Z"/><path d="M9 8c1 3 2 4 5 5"/>{% when 'address' %}<path d="M12 21s7-6 7-12a7 7 0 1 0-14 0c0 6 7 12 7 12Z"/><circle cx="12" cy="9" r="2"/>{% else %}<path d="M4 5h16v12H8l-4 3V5Z"/>{% endcase %}</svg></span><h3>{{ block.settings.title | escape }}</h3><p>{{ block.settings.description | escape }}</p>{% if block.settings.link != blank %}<a href="{{ block.settings.link }}">{{ block.settings.link_text | escape }}</a>{% elsif block.settings.link_text != blank %}<span class="contact-method-card__value">{{ block.settings.link_text | escape }}</span>{% endif %}</article>{% endfor %}</div>
</div></section>
{% schema %}{"name":"Contact methods","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Choose what suits you"},{"type":"text","id":"heading","label":"Heading","default":"Ways to reach us"},{"type":"richtext","id":"description","label":"Description","default":"<p>Connect with our support team through your preferred channel.</p>"},{"type":"select","id":"alignment","label":"Header alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"center"},{"type":"range","id":"columns","label":"Desktop columns","min":2,"max":4,"step":1,"default":4},{"type":"range","id":"gap","label":"Card gap","min":8,"max":40,"step":2,"unit":"px","default":18},{"type":"range","id":"radius","label":"Card radius","min":0,"max":30,"step":2,"unit":"px","default":18},{"type":"range","id":"container_width","label":"Container width","min":900,"max":1800,"step":20,"unit":"px","default":1400},{"type":"color","id":"background","label":"Background","default":"#fffdf9"},{"type":"color","id":"card_background","label":"Card background","default":"#fffaf3"},{"type":"color","id":"text_color","label":"Text","default":"#3d1f15"},{"type":"color","id":"muted_color","label":"Description","default":"#705b52"},{"type":"color","id":"accent_color","label":"Accent","default":"#a65332"},{"type":"color","id":"border_color","label":"Border","default":"#e2d6ca"},{"type":"range","id":"padding_top","label":"Top padding","min":20,"max":140,"step":4,"unit":"px","default":76},{"type":"range","id":"padding_bottom","label":"Bottom padding","min":20,"max":140,"step":4,"unit":"px","default":76}],"blocks":[{"type":"method","name":"Contact method","settings":[{"type":"select","id":"icon","label":"Icon","options":[{"value":"email","label":"Email"},{"value":"phone","label":"Phone"},{"value":"whatsapp","label":"WhatsApp"},{"value":"address","label":"Address"},{"value":"chat","label":"Live chat"}],"default":"email"},{"type":"text","id":"title","label":"Title","default":"Email us"},{"type":"text","id":"description","label":"Description","default":"Send us a note and we’ll reply shortly."},{"type":"text","id":"link_text","label":"Link or display text","default":"hello@example.com"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"Contact methods","blocks":[{"type":"method"},{"type":"method","settings":{"icon":"phone","title":"Call us","link_text":"Mon–Sat, 10am–6pm"}},{"type":"method","settings":{"icon":"whatsapp","title":"WhatsApp","link_text":"Chat with our team"}},{"type":"method","settings":{"icon":"address","title":"Visit us","link_text":"View our location"}}]}]}{% endschema %}
