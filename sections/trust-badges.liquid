{% comment %}
  Compact trust strip. All colours are configurable and default to the brand palette.
{% endcomment %}

<section
  class="trust-badges trust-badges--{{ section.id }}"
  aria-label="{{ section.settings.accessibility_label | escape }}"
  style="
    --trust-bg: {{ section.settings.background }};
    --trust-card: {{ section.settings.card_background }};
    --trust-heading: {{ section.settings.heading_color }};
    --trust-copy: {{ section.settings.text_color }};
    --trust-accent: {{ section.settings.accent_color }};
    --trust-icon-bg: {{ section.settings.icon_background }};
    --trust-border: {{ section.settings.border_color }};
  "
>
  <div class="trust-badges__inner">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank %}
      <header class="trust-badges__header">
        {% if section.settings.eyebrow != blank %}
          <p class="trust-badges__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="trust-badges__heading">{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </header>
    {% endif %}

    <div class="trust-badges__grid" style="--trust-columns: {{ section.blocks.size }};">
      {% for block in section.blocks %}
        <article class="trust-badges__item" {{ block.shopify_attributes }}>
          <span class="trust-badges__icon" aria-hidden="true">
            {% case block.settings.icon %}
              {% when 'shield' %}
                <svg viewBox="0 0 24 24"><path d="M12 3 5.5 5.6v5.6c0 4.1 2.6 7.8 6.5 9.3 3.9-1.5 6.5-5.2 6.5-9.3V5.6L12 3Z"/><path d="m9 12 2 2 4-4"/></svg>
              {% when 'sparkle' %}
                <svg viewBox="0 0 24 24"><path d="M12 2.8c.7 4.9 3.3 7.5 8.2 8.2-4.9.7-7.5 3.3-8.2 8.2-.7-4.9-3.3-7.5-8.2-8.2 4.9-.7 7.5-3.3 8.2-8.2Z"/><path d="M19 3v4M21 5h-4"/></svg>
              {% when 'delivery' %}
                <svg viewBox="0 0 24 24"><path d="M3 6h11v11H3zM14 10h3l4 4v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
              {% when 'heart' %}
                <svg viewBox="0 0 24 24"><path d="M20.8 5.8c-2-2-5.2-2-7.2 0L12 7.4l-1.6-1.6c-2-2-5.2-2-7.2 0s-2 5.2 0 7.2l1.6 1.6L12 21l7.2-6.4 1.6-1.6c2-2 2-5.2 0-7.2Z"/></svg>
              {% when 'return' %}
                <svg viewBox="0 0 24 24"><path d="M8 7H4v-4"/><path d="M4.5 7A9 9 0 1 1 3 15"/><path d="m9 12 2 2 4-4"/></svg>
              {% when 'lock' %}
                <svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="1.5"/><path d="M8.5 10V7.5a3.5 3.5 0 0 1 7 0V10M12 14v3"/></svg>
              {% when 'bolt' %}
                <svg viewBox="0 0 24 24"><path d="m13.5 2-8 12h6l-1 8 8-12h-6l1-8Z"/></svg>
            {% endcase %}
          </span>
          <div class="trust-badges__content">
            <h3>{{ block.settings.title | escape }}</h3>
            {% if block.settings.text != blank %}<p>{{ block.settings.text | escape }}</p>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
  .trust-badges {
    background: var(--trust-bg);
    color: var(--trust-copy);
    padding: 28px 24px;
  }

  .trust-badges__inner {
    width: min(100%, 1360px);
    margin-inline: auto;
  }

  .trust-badges__header {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin-bottom: 16px;
  }

  .trust-badges__eyebrow {
    margin: 0;
    color: var(--trust-accent);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: .14em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .trust-badges__heading {
    margin: 0;
    color: var(--trust-heading);
    font-size: clamp(20px, 2vw, 27px);
    line-height: 1.15;
  }

  .trust-badges__grid {
    display: grid;
    grid-template-columns: repeat(var(--trust-columns, 4), minmax(0, 1fr));
    overflow: hidden;
    border: 1px solid var(--trust-border);
    border-radius: 16px;
    background: var(--trust-card);
    box-shadow: 0 12px 30px rgba(42, 31, 26, .07);
  }

  .trust-badges__item {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 12px;
    padding: 17px 18px;
  }

  .trust-badges__item + .trust-badges__item {
    border-left: 1px solid var(--trust-border);
  }

  .trust-badges__icon {
    display: grid;
    flex: 0 0 40px;
    width: 40px;
    height: 40px;
    place-items: center;
    border: 1px solid var(--trust-border);
    border-radius: 50%;
    background: var(--trust-icon-bg);
    color: var(--trust-heading);
  }

  .trust-badges__icon svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
  }

  .trust-badges__content h3,
  .trust-badges__content p {
    margin: 0;
  }

  .trust-badges__content h3 {
    color: var(--trust-heading);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.25;
  }

  .trust-badges__content p {
    margin-top: 3px;
    color: var(--trust-copy);
    font-size: 12px;
    line-height: 1.35;
  }

  @media screen and (max-width: 989px) {
    .trust-badges__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .trust-badges__item:nth-child(odd) { border-left: 0; }
    .trust-badges__item:nth-child(n + 3) { border-top: 1px solid var(--trust-border); }
  }

  @media screen and (max-width: 599px) {
    .trust-badges { padding: 22px 16px; }
    .trust-badges__header { display: block; margin-bottom: 13px; }
    .trust-badges__heading { margin-top: 5px; font-size: 20px; }
    .trust-badges__grid { border-radius: 14px; }
    .trust-badges__item { gap: 10px; padding: 13px 12px; }
    .trust-badges__icon { flex-basis: 34px; width: 34px; height: 34px; }
    .trust-badges__icon svg { width: 18px; height: 18px; }
    .trust-badges__content h3 { font-size: 12px; }
    .trust-badges__content p { font-size: 10px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Premium trust badges",
  "tag": "section",
  "class": "section-trust-badges",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "accessibility_label", "label": "Accessibility label", "default": "Why shop with us" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Antakshari promise" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Made with care, delivered with confidence" },
    { "type": "header", "content": "Brand colours" },
    { "type": "color", "id": "background", "label": "Section background", "default": "#F7F1E3" },
    { "type": "color", "id": "card_background", "label": "Card background", "default": "#FCFAF5" },
    { "type": "color", "id": "heading_color", "label": "Heading and icon", "default": "#6B1F2A" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#2A1F1A" },
    { "type": "color", "id": "accent_color", "label": "Eyebrow", "default": "#C56B3E" },
    { "type": "color", "id": "icon_background", "label": "Icon background", "default": "#E8A53A" },
    { "type": "color", "id": "border_color", "label": "Borders", "default": "#C9A24C" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "delivery", "label": "Delivery" },
            { "value": "heart", "label": "Heart" },
            { "value": "return", "label": "Returns" },
            { "value": "lock", "label": "Lock" },
            { "value": "bolt", "label": "Lightning" }
          ],
          "default": "shield"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Quality assured" },
        { "type": "text", "id": "text", "label": "Supporting text", "default": "Thoughtfully selected" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Premium trust badges",
      "blocks": [
        { "type": "badge", "settings": { "icon": "sparkle", "title": "Premium Fabrics", "text": "" } },
        { "type": "badge", "settings": { "icon": "heart", "title": "Crafted for Comfort", "text": "" } },
        { "type": "badge", "settings": { "icon": "delivery", "title": "Easy Returns", "text": "" } },
        { "type": "badge", "settings": { "icon": "lock", "title": "Secure Payments", "text": "" } },
        { "type": "badge", "settings": { "icon": "bolt", "title": "Made for Celebrations", "text": "" } }
      ]
    }
  ]
}
{% endschema %}
