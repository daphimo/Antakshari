{{ 'blog-guides.css' | asset_url | stylesheet_tag }}

{% liquid
  assign selected_blog = section.settings.blog

  assign button_url = section.settings.button_link
  if button_url == blank and selected_blog != blank
    assign button_url = selected_blog.url
  endif
%}

<section
  id="blog-guides-{{ section.id }}"
  class="blog-guides"
  style="
    --blog-guides-section-background: {{ section.settings.section_background }};
    --blog-guides-card-background: {{ section.settings.card_background }};
    --blog-guides-border-color: {{ section.settings.border_color }};
    --blog-guides-container-width: {{ section.settings.container_width }}px;
    --blog-guides-section-padding-top: {{ section.settings.padding_top }}px;
    --blog-guides-section-padding-bottom: {{ section.settings.padding_bottom }}px;
    --blog-guides-mobile-padding-top: {{ section.settings.mobile_padding_top }}px;
    --blog-guides-mobile-padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    --blog-guides-horizontal-padding: {{ section.settings.horizontal_padding }}px;

    --blog-guides-wrapper-padding-top: {{ section.settings.wrapper_padding_top }}px;
    --blog-guides-wrapper-padding-bottom: {{ section.settings.wrapper_padding_bottom }}px;
    --blog-guides-wrapper-padding-inline: {{ section.settings.wrapper_padding_inline }}px;
    --blog-guides-mobile-wrapper-padding: {{ section.settings.mobile_wrapper_padding }}px;
    --blog-guides-wrapper-radius: {{ section.settings.wrapper_radius }}px;
    --blog-guides-wrapper-border-width: {{ section.settings.wrapper_border_width }}px;

    --blog-guides-header-gap: {{ section.settings.header_gap }}px;
    --blog-guides-cards-gap: {{ section.settings.cards_gap }}px;
    --blog-guides-card-padding: {{ section.settings.card_padding }}px;
    --blog-guides-card-min-height: {{ section.settings.card_min_height }}px;
    --blog-guides-card-radius: {{ section.settings.card_radius }}px;
    --blog-guides-card-border-width: {{ section.settings.card_border_width }}px;

    --blog-guides-caption-size: {{ section.settings.caption_size }}px;
    --blog-guides-caption-mobile-size: {{ section.settings.caption_mobile_size }}px;
    --blog-guides-caption-color: {{ section.settings.caption_color }};
    --blog-guides-caption-spacing: {{ section.settings.caption_letter_spacing | divided_by: 10.0 }}em;

    --blog-guides-heading-size: {{ section.settings.heading_size }}px;
    --blog-guides-heading-mobile-size: {{ section.settings.heading_mobile_size }}px;
    --blog-guides-heading-color: {{ section.settings.heading_color }};
    --blog-guides-heading-line-height: {{ section.settings.heading_line_height | divided_by: 100.0 }};

    --blog-guides-content-size: {{ section.settings.content_size }}px;
    --blog-guides-content-mobile-size: {{ section.settings.content_mobile_size }}px;
    --blog-guides-content-color: {{ section.settings.content_color }};
    --blog-guides-content-line-height: {{ section.settings.content_line_height | divided_by: 100.0 }};

    --blog-guides-meta-size: {{ section.settings.meta_size }}px;
    --blog-guides-meta-mobile-size: {{ section.settings.meta_mobile_size }}px;
    --blog-guides-meta-color: {{ section.settings.meta_color }};
    --blog-guides-meta-spacing: {{ section.settings.meta_letter_spacing | divided_by: 10.0 }}em;

    --blog-guides-title-size: {{ section.settings.article_title_size }}px;
    --blog-guides-title-mobile-size: {{ section.settings.article_title_mobile_size }}px;
    --blog-guides-title-color: {{ section.settings.article_title_color }};
    --blog-guides-title-line-height: {{ section.settings.article_title_line_height | divided_by: 100.0 }};

    --blog-guides-button-size: {{ section.settings.button_size }}px;
    --blog-guides-button-color: {{ section.settings.button_color }};
    --blog-guides-hover-lift: {{ section.settings.hover_lift }}px;
    --blog-guides-hover-shadow-opacity: {{ section.settings.hover_shadow_opacity | divided_by: 100.0 }};
  "
>
  <div class="blog-guides__container">
    <div class="blog-guides__wrapper">
      <div class="blog-guides__header">
        <div class="blog-guides__heading-area">
          {% if section.settings.caption != blank %}
            <div class="blog-guides__caption">
              {{ section.settings.caption }}
            </div>
          {% endif %}

          {% if section.settings.heading != blank %}
            <{{ section.settings.heading_tag }} class="blog-guides__heading">
              {{ section.settings.heading }}
            </{{ section.settings.heading_tag }}>
          {% endif %}
        </div>

        <div class="blog-guides__right-area">
          {% if section.settings.content != blank %}
            <div class="blog-guides__content rte">
              {{ section.settings.content }}
            </div>
          {% endif %}

          {% if section.settings.button_label != blank %}
            <a
              href="{{ button_url | default: '#' }}"
              class="blog-guides__button"
            >
              <span>{{ section.settings.button_label }}</span>

              {% if section.settings.show_button_arrow %}
                <span class="blog-guides__button-icon" aria-hidden="true">
                  <svg
                    viewBox="0 0 24 24"
                    width="17"
                    height="17"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
                  >
                    <path
                      d="M5 12H19M13 6L19 12L13 18"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
              {% endif %}
            </a>
          {% endif %}
        </div>
      </div>

      <div class="blog-guides__articles">
        {% if selected_blog != blank and selected_blog.articles_count > 0 %}
          {% for article in selected_blog.articles limit: 3 %}
            <article class="blog-guides__card">
              <a
                href="{{ article.url }}"
                class="blog-guides__card-link"
                aria-label="{{ article.title | escape }}"
              >
                {% if section.settings.show_article_label %}
                  <div class="blog-guides__article-meta">
                    {% if section.settings.use_article_tags and article.tags.size > 0 %}
                      {{ article.tags.first }}
                    {% else %}
                      {{ selected_blog.title }}
                    {% endif %}
                  </div>
                {% endif %}

                <h3 class="blog-guides__article-title">
                  {{ article.title }}
                </h3>

                {% if section.settings.show_excerpt %}
                  <div class="blog-guides__excerpt">
                    {% if article.excerpt != blank %}
                      {{ article.excerpt | strip_html | truncatewords: section.settings.excerpt_words }}
                    {% else %}
                      {{ article.content | strip_html | truncatewords: section.settings.excerpt_words }}
                    {% endif %}
                  </div>
                {% endif %}

                {% if section.settings.show_date or section.settings.show_author %}
                  <div class="blog-guides__details">
                    {% if section.settings.show_date %}
                      <span>
                        {{ article.published_at | date: section.settings.date_format }}
                      </span>
                    {% endif %}

                    {% if section.settings.show_date and section.settings.show_author %}
                      <span aria-hidden="true">•</span>
                    {% endif %}

                    {% if section.settings.show_author %}
                      <span>{{ article.author }}</span>
                    {% endif %}
                  </div>
                {% endif %}
              </a>
            </article>
          {% endfor %}
        {% else %}
          {% for i in (1..3) %}
            <article class="blog-guides__card">
              <div class="blog-guides__card-link">
                <div class="blog-guides__article-meta">
                  Article category
                </div>

                <h3 class="blog-guides__article-title">
                  Select a blog to display article {{ i }}
                </h3>
              </div>
            </article>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  </div>
</section>

