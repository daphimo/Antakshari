{{ 'collection-category-slider.css' | asset_url | stylesheet_tag }}

{% liquid
  assign section_class = 'collection-category-slider-' | append: section.id
%}

<section
  class="collection-category-slider {{ section_class }}"
  style="
    --ccs-background: {{ section.settings.background_color }};
    --ccs-content-width: {{ section.settings.content_width }}%;
    --ccs-section-max-width: {{ section.settings.section_max_width }}px;

    --ccs-padding-top: {{ section.settings.padding_top }}px;
    --ccs-padding-bottom: {{ section.settings.padding_bottom }}px;
    --ccs-padding-inline: {{ section.settings.padding_inline }}px;
    --ccs-column-gap: {{ section.settings.column_gap }}px;

    --ccs-caption-color: {{ section.settings.caption_color }};
    --ccs-caption-size: {{ section.settings.caption_size }}px;
    --ccs-caption-mobile-size: {{ section.settings.caption_mobile_size }}px;
    --ccs-caption-spacing: {{ section.settings.caption_spacing }}px;

    --ccs-title-color: {{ section.settings.title_color }};
    --ccs-title-size: {{ section.settings.title_size }}px;
    --ccs-title-mobile-size: {{ section.settings.title_mobile_size }}px;
    --ccs-title-line-height: {{ section.settings.title_line_height | divided_by: 100.0 }};
    --ccs-title-spacing: {{ section.settings.title_spacing }}px;
    --ccs-title-max-width: {{ section.settings.title_max_width }}px;

    --ccs-text-color: {{ section.settings.text_color }};
    --ccs-text-size: {{ section.settings.text_size }}px;
    --ccs-text-mobile-size: {{ section.settings.text_mobile_size }}px;
    --ccs-text-line-height: {{ section.settings.text_line_height | divided_by: 100.0 }};

    --ccs-card-height: {{ section.settings.card_height }}px;
    --ccs-card-mobile-height: {{ section.settings.card_mobile_height }}px;
    --ccs-card-radius: {{ section.settings.card_radius }}px;
    --ccs-card-lift: {{ section.settings.card_lift }}px;

    --ccs-label-background: {{ section.settings.label_background }};
    --ccs-label-color: {{ section.settings.label_color }};
    --ccs-label-size: {{ section.settings.label_size }}px;
    --ccs-label-mobile-size: {{ section.settings.label_mobile_size }}px;
    --ccs-label-radius: {{ section.settings.label_radius }}px;
    --ccs-label-padding-y: {{ section.settings.label_padding_y }}px;
    --ccs-label-padding-x: {{ section.settings.label_padding_x }}px;
    --ccs-label-top: {{ section.settings.label_top }}px;
    --ccs-label-left: {{ section.settings.label_left }}px;

    --ccs-arrow-background: {{ section.settings.arrow_background }};
    --ccs-arrow-color: {{ section.settings.arrow_color }};
    --ccs-arrow-size: {{ section.settings.arrow_size }}px;

    --ccs-pagination-color: {{ section.settings.pagination_color }};
    --ccs-pagination-active-color: {{ section.settings.pagination_active_color }};
  "
>
  <div
    class="
      collection-category-slider__container
      collection-category-slider__container--{{ section.settings.content_vertical_alignment }}
    "
  >
    <div
      class="
        collection-category-slider__content
        collection-category-slider__content--{{ section.settings.text_alignment }}
      "
    >
      {% if section.settings.caption != blank %}
        <div class="collection-category-slider__caption">
          {{ section.settings.caption }}
        </div>
      {% endif %}

      {% if section.settings.heading != blank %}
        <{{ section.settings.heading_tag }} class="collection-category-slider__heading">
          {{ section.settings.heading }}
        </{{ section.settings.heading_tag }}>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="collection-category-slider__description rte">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>

    <div class="collection-category-slider__slider-wrapper">
      <div
        id="splide-{{ section.id }}"
        class="splide collection-category-slider__splide{% if section.blocks.size <= 1 %} collection-category-slider__splide--single{% endif %}"
      >
        <div class="splide__track">
          <ul class="splide__list">
            {% for block in section.blocks %}
              {% liquid
                assign card_collection = block.settings.collection
                assign card_image = block.settings.image

                if card_image == blank and card_collection != blank
                  assign card_image = card_collection.featured_image
                endif

                assign card_title = block.settings.title
                if card_title == blank and card_collection != blank
                  assign card_title = card_collection.title
                endif

                assign card_link = block.settings.link
                if card_link == blank and card_collection != blank
                  assign card_link = card_collection.url
                endif
              %}

              <li
                class="splide__slide collection-category-slider__slide"
                data-block-id="{{ block.id }}"
                data-slide-index="{{ forloop.index0 }}"
                {{ block.shopify_attributes }}
              >
                {% if card_link != blank %}
                  <a
                    href="{{ card_link }}"
                    class="collection-category-slider__card"
                    aria-label="{{ card_title | default: 'View collection' | escape }}"
                  >
                {% else %}
                  <div class="collection-category-slider__card">
                {% endif %}

                  <div class="collection-category-slider__media">
                    {% if card_image != blank %}
                      {{
                        card_image
                        | image_url: width: 1200
                        | image_tag:
                          loading: 'lazy',
                          widths: '300, 375, 450, 600, 800, 1000, 1200',
                          sizes: '(min-width: 990px) 25vw, (min-width: 750px) 40vw, 75vw',
                          class: 'collection-category-slider__image',
                          alt: card_image.alt | default: card_title
                      }}
                    {% else %}
                      {{
                        'collection-1'
                        | placeholder_svg_tag:
                          'collection-category-slider__placeholder'
                      }}
                    {% endif %}
                  </div>

                  {% if card_title != blank %}
                    <span class="collection-category-slider__card-title">
                      {{ card_title }}
                    </span>
                  {% endif %}

                {% if card_link != blank %}
                  </a>
                {% else %}
                  </div>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </div>

        {% if section.settings.show_arrows and section.blocks.size > 1 %}
          <div class="splide__arrows collection-category-slider__arrows">
            <button
              class="splide__arrow splide__arrow--prev"
              type="button"
              aria-label="Previous slide"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="M15 18 9 12l6-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>

            <button
              class="splide__arrow splide__arrow--next"
              type="button"
              aria-label="Next slide"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
                focusable="false"
              >
                <path
                  d="m9 18 6-6-6-6"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </button>
          </div>
        {% endif %}

        {% if section.settings.show_pagination and section.blocks.size > 1 %}
          <ul class="splide__pagination"></ul>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% render 'splide-slider',
  slider_id: section.id,
  section_id: section.id
%}

