{% liquid
  assign threshold = settings.cart_free_shipping_threshold | times: 100
  assign remaining = threshold | minus: cart.total_price
  assign reward_one_threshold = settings.cart_reward_one_threshold | times: 100
  assign reward_two_threshold = settings.cart_reward_two_threshold | times: 100
  assign reward_three_threshold = settings.cart_reward_three_threshold | times: 100
  assign latest_reward_success_message = blank
  if settings.cart_rewards_enabled
    if reward_three_threshold > 0 and cart.total_price >= reward_three_threshold
      assign latest_reward_success_message = settings.cart_reward_three_success_message | default: settings.cart_reward_three_text
    elsif reward_two_threshold > 0 and cart.total_price >= reward_two_threshold
      assign latest_reward_success_message = settings.cart_reward_two_success_message | default: settings.cart_reward_two_text
    elsif reward_one_threshold > 0 and cart.total_price >= reward_one_threshold
      assign latest_reward_success_message = settings.cart_reward_one_success_message | default: settings.cart_free_shipping_unlocked_message
    endif
  endif
  assign rewards_progress = 0
  if cart.total_price >= reward_three_threshold
    assign rewards_progress = 100
  elsif cart.total_price >= reward_two_threshold
    assign reward_step_amount = reward_three_threshold | minus: reward_two_threshold
    if reward_step_amount > 0
      assign reward_step_progress = cart.total_price | minus: reward_two_threshold | times: 50.0 | divided_by: reward_step_amount
      assign rewards_progress = 50 | plus: reward_step_progress
    else
      assign rewards_progress = 50
    endif
  elsif cart.total_price >= reward_one_threshold
    assign reward_step_amount = reward_two_threshold | minus: reward_one_threshold
    if reward_step_amount > 0
      assign rewards_progress = cart.total_price | minus: reward_one_threshold | times: 50.0 | divided_by: reward_step_amount
    endif
  endif
%}

{% if settings.cart_free_shipping_enabled and threshold > 0 and cart.item_count > 0 %}
  <div class="cart-free-shipping" data-cart-free-shipping>
    <div class="cart-assurance" aria-label="Shopping assurances">
      <span>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M3 6h11v11H3zM14 10h3l4 4v3h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
        {{ settings.cart_assurance_shipping_text }}
      </span>
      <i aria-hidden="true"></i>
      <span>
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M12 3 5.5 5.6v5.6c0 4.1 2.6 7.8 6.5 9.3 3.9-1.5 6.5-5.2 6.5-9.3V5.6L12 3Z"/><path d="m9 12 2 2 4-4"/></svg>
        {{ settings.cart_assurance_payment_text }}
      </span>
    </div>
    <p class="cart-free-shipping__message" aria-live="polite">
      {% if latest_reward_success_message != blank %}
        {{ latest_reward_success_message }}
      {% elsif remaining <= 0 %}
        {{ settings.cart_free_shipping_unlocked_message }}
      {% else %}
        {% assign remaining_money = remaining | money_with_currency %}
        {{ settings.cart_free_shipping_message | replace: '[amount]', remaining_money }}
      {% endif %}
    </p>
    {% if settings.cart_rewards_enabled %}
      <div
        class="cart-rewards"
        role="region"
        aria-label="Cart reward milestones"
      >
        {% if settings.cart_rewards_heading != blank %}
          <p class="cart-rewards__heading">{{ settings.cart_rewards_heading }}</p>
        {% endif %}
        <div class="cart-rewards__rail">
          <progress
            class="cart-rewards__progress"
            max="100"
            value="{{ rewards_progress | at_most: 100 | at_least: 0 }}"
            aria-label="Progress through cart reward milestones"
          ></progress>
          {% for reward_index in (1..3) %}
            {% liquid
              case reward_index
                when 1
                  assign reward_threshold = reward_one_threshold
                  assign reward_label = settings.cart_reward_one_label
                  assign reward_text = settings.cart_reward_one_text
                when 2
                  assign reward_threshold = reward_two_threshold
                  assign reward_label = settings.cart_reward_two_label
                  assign reward_text = settings.cart_reward_two_text
                when 3
                  assign reward_threshold = reward_three_threshold
                  assign reward_label = settings.cart_reward_three_label
                  assign reward_text = settings.cart_reward_three_text
              endcase
              assign reward_unlocked = false
              if cart.total_price >= reward_threshold
                assign reward_unlocked = true
              endif
              assign reward_money = reward_threshold | money_without_trailing_zeros
            %}
            <div
              class="cart-rewards__item{% if reward_unlocked %} is-unlocked{% endif %}"
              data-threshold="{{ reward_threshold }}"
            >
              <span class="visually-hidden">
                {% if reward_unlocked %}Unlocked:{% else %}Locked:{% endif %}
              </span>
              <span class="cart-rewards__icon" aria-hidden="true">
                {% if reward_unlocked %}
                  <svg viewBox="0 0 24 24"><path d="m6.5 12.5 3.5 3.5 7.5-8"/></svg>
                {% else %}
                  <svg viewBox="0 0 24 24"><path d="M4 10h16v10H4zM3 7h18v4H3zM12 7v13M12 7H8.7a2.2 2.2 0 1 1 2.2-2.2C10.9 6 12 7 12 7Zm0 0h3.3a2.2 2.2 0 1 0-2.2-2.2C13.1 6 12 7 12 7Z"/></svg>
                {% endif %}
              </span>
              <span class="cart-rewards__label">{{ reward_label | replace: '[amount]', reward_money }}</span>
              <span class="cart-rewards__text">{{ reward_text }}</span>
            </div>
          {% endfor %}
        </div>
        {% if settings.cart_rewards_note != blank %}
          <p class="cart-rewards__note">{{ settings.cart_rewards_note }}</p>
        {% endif %}
      </div>
    {% endif %}
  </div>
{% endif %}