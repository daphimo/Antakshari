{%- comment -%}
  Reusable Splide Slider Snippet
  Usage:
  {% render 'splide-slider',
    slider_id: section.id,
    section_id: section.id,
    config: splide_config
  %}

  Requirements:
  - Wrap slides with .splide__slide
  - Each slide must have:
    data-block-id="{{ block.id }}"
    data-slide-index="{{ forloop.index0 }}"
    {{ block.shopify_attributes }}

    Loop startalwasy
    <li
                class="splide__slide relative"
                data-block-id="{{ block.id }}"
                data-slide-index="{{ forloop.index0 }}"
                {{ block.shopify_attributes }}
              >
{%- endcomment -%}

{%- assign custom_slider_id = slider_id | default: section.id -%}
{%- assign custom_section_id = section_id | default: section.id -%}
{%- assign custom_safe_id = custom_slider_id | replace: '-', '_' | replace: '__', '_' -%}
{%- assign custom_slider_type = slider_type | default: section.settings.slider_type | default: 'loop' -%}

<script>
  (function () {
    if (!window.__splideState) {
      window.__splideState = {};
    }

    var sliderId = "splide-{{ custom_slider_id }}";
    var stateKey = "{{ custom_section_id }}-{{ custom_slider_id }}";
    var viewportObserver;
    var libraryRetries = 0;

    function initSplide_{{ custom_safe_id }}() {
      if (typeof Splide === 'undefined') {
        if (libraryRetries < 20) {
          libraryRetries += 1;
          setTimeout(initSplide_{{ custom_safe_id }}, 100);
        }
        return;
      }

      var el = document.getElementById(sliderId);
      if (!el) return;

      // Never mount or recreate a slider that is already functional.
      if (el.splideInstance) return;

      // A single slide needs no carousel measurements, clones, or listeners.
      if (el.querySelectorAll('.splide__slide').length <= 1) {
        el.style.visibility = 'visible';
        return;
      }

      var defaultConfig = {
        type: Shopify.designMode ? 'slide' : '{{ custom_slider_type }}',
        {% if custom_slider_type == 'slide' %}
          rewind: {{ rewind | default: true, allow_false: true | json }},
        {% endif %}
        perPage: {{ section.settings.perPageDesktop | default: 1 }},
        perMove: {{ section.settings.perMove | default: 1 }},
        autoplay: Shopify.designMode
          ? false
          : {{ section.settings.autoplay | default: false, allow_false: true | json }},
        interval: {{ section.settings.autoplay_speed | default: 3 | times: 1000 }},
        speed: {{ section.settings.transition_speed | default: 400 }},
        arrows: {{ section.settings.show_arrows | default: true, allow_false: true | json }},
        pagination: {{ section.settings.show_pagination | default: false, allow_false: true | json }},
        gap: '{{ section.settings.gap | default: 10 }}px',
        pauseOnHover: {{ section.settings.pause_on_hover | default: false, allow_false: true | json }},
        pauseOnFocus: {{ section.settings.pause_on_focus | default: false, allow_false: true | json }},
        focus: Shopify.designMode ? false : {{ section.settings.focus | json }},
        breakpoints: {
          768: {
            perPage: {{ section.settings.perPageMobile | default: 1 }},
            gap: '{{ section.settings.gap_mobile | default: 8 }}px'
          },
          480: {
            perPage: {{ section.settings.perPageMobile | default: 1 }},
            gap: '{{ section.settings.gap_mobile | default: 6 }}px'
          }
        }
      };

      {% if config %}
        var config = Object.assign({}, defaultConfig, {{ config | json }});
      {% else %}
        var config = defaultConfig;
      {% endif %}

      var splide = new Splide(el, config);

      // Restore last known slide (editor refresh fix)
      splide.on('mounted', function () {
        el.style.visibility = 'visible';
        var savedIndex = window.__splideState[stateKey];
        if (Shopify.designMode && typeof savedIndex === 'number') {
          splide.go(savedIndex);
        }
      });

      // Track active slide
      splide.on('move', function (newIndex) {
        window.__splideState[stateKey] = newIndex;
      });

      splide.mount();
      el.splideInstance = splide;

      // Stop autoplay work while an initialized slider is off screen.
      if (!Shopify.designMode && config.autoplay && 'IntersectionObserver' in window) {
        viewportObserver = new IntersectionObserver(function (entries) {
          var autoplay = splide.Components && splide.Components.Autoplay;
          if (!autoplay) return;
          if (entries[0].isIntersecting) autoplay.play();
          else autoplay.pause();
        });
        viewportObserver.observe(el);
      }
    }

    function scheduleSplide_{{ custom_safe_id }}() {
      var el = document.getElementById(sliderId);
      if (!el || el.splideInstance) return;

      if (Shopify.designMode || !('IntersectionObserver' in window)) {
        initSplide_{{ custom_safe_id }}();
        return;
      }

      // Above-the-fold sliders initialize immediately; lower sliders wait until
      // they approach the viewport, avoiding early layout and clone work.
      var rect = el.getBoundingClientRect();
      if (rect.top < window.innerHeight + 300 && rect.bottom > -300) {
        initSplide_{{ custom_safe_id }}();
        return;
      }

      var initObserver = new IntersectionObserver(
        function (entries) {
          if (!entries[0].isIntersecting) return;
          initObserver.disconnect();
          initSplide_{{ custom_safe_id }}();
        },
        { rootMargin: '300px 0px' }
      );
      initObserver.observe(el);
    }

    // Init on load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', scheduleSplide_{{ custom_safe_id }}, { once: true });
    } else {
      scheduleSplide_{{ custom_safe_id }}();
    }

    // Section reload (Theme Editor)
    document.addEventListener('shopify:section:load', function (e) {
      if (e.detail.sectionId === "{{ custom_section_id }}") {
        setTimeout(scheduleSplide_{{ custom_safe_id }}, 100);
      }
    });

    // Section unload cleanup
    document.addEventListener('shopify:section:unload', function (e) {
      if (e.detail.sectionId === "{{ custom_section_id }}") {
        var el = document.getElementById(sliderId);
        if (el && el.splideInstance) {
          el.splideInstance.destroy(true);
          delete el.splideInstance;
        }
        viewportObserver?.disconnect();
      }
    });

    // 🔥 Block → slide sync (MAIN FIX)
    if (Shopify.designMode) {
      document.addEventListener('shopify:block:select', function (e) {
        var slide = document.querySelector(
          '#' + sliderId + ' [data-block-id="' + e.detail.blockId + '"]'
        );
        if (!slide) return;

        var index = Number(slide.dataset.slideIndex);
        window.__splideState[stateKey] = index;

        var el = document.getElementById(sliderId);
        if (el && el.splideInstance) {
          el.splideInstance.go(index);
        }
      });
    }
  })();
</script>

{% comment %}
  {% schema %}
      {
        "type": "header",
        "content": "Splide Settings"
      },
      {
        "type": "select",
        "id": "slider_type",
        "label": "Slider Type",
        "options": [
          {
            "value": "slide",
            "label": "Slide"
          },
          {
            "value": "loop",
            "label": "Loop"
          },
          {
            "value": "fade",
            "label": "Fade"
          }
        ],
        "default": "loop"
      },
      {
        "type": "range",
        "id": "perPageDesktop",
        "label": "Slides per view (Desktop)",
        "min": 1,
        "max": 6,
        "step": 1,
        "default": 3
      },
      {
        "type": "range",
        "id": "perPageMobile",
        "label": "Slides per view (Mobile)",
        "min": 0.5,
        "max": 3,
        "step": 0.5,
        "default": 1.5
      },
      {
        "type": "range",
        "id": "perMove",
        "label": "Slides to move",
        "min": 1,
        "max": 3,
        "step": 1,
        "default": 1
      },
      {
        "type": "range",
        "id": "gap",
        "label": "Gap between slides (Desktop)",
        "default": 20,
        "min": 0,
        "max": 60
      },
      {
        "type": "range",
        "id": "gap_mobile",
        "label": "Gap between slides (Mobile)",
        "default": 10,
        "min": 0,
        "max": 60
      },
      {
        "type": "checkbox",
        "id": "autoplay",
        "label": "Enable autoplay",
        "default": false
      },
      {
        "type": "range",
        "id": "autoplay_speed",
        "label": "Autoplay speed (seconds)",
        "min": 1,
        "max": 10,
        "step": 1,
        "default": 3
      },
      {
        "type": "range",
        "id": "transition_speed",
        "label": "Transition speed (milliseconds)",
        "min": 300,
        "max": 2000,
        "step": 100,
        "default": 1000
      },
      {
        "type": "checkbox",
        "id": "show_arrows",
        "label": "Show navigation arrows",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_pagination",
        "label": "Show pagination dots",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "pause_on_hover",
        "label": "Pause on hover",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "pause_on_focus",
        "label": "Pause on focus",
        "default": true
      }
  {% endschema %}
{% endcomment %}
